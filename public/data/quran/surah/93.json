{
  "verses": [
    {
      "id": 6080,
      "verse_number": 1,
      "verse_key": "93:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلضُّحَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 177508,
          "resource_id": 33,
          "text": "Demi waktu duha (ketika matahari naik sepenggalan),"
        }
      ]
    },
    {
      "id": 6081,
      "verse_number": 2,
      "verse_key": "93:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181208,
          "resource_id": 33,
          "text": "dan demi malam apabila telah sunyi,"
        }
      ]
    },
    {
      "id": 6082,
      "verse_number": 3,
      "verse_key": "93:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181193,
          "resource_id": 33,
          "text": "Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu,<sup foot_note=135861>1</sup>"
        }
      ]
    },
    {
      "id": 6083,
      "verse_number": 4,
      "verse_key": "93:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181195,
          "resource_id": 33,
          "text": "dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan.<sup foot_note=135862>1</sup>"
        }
      ]
    },
    {
      "id": 6084,
      "verse_number": 5,
      "verse_key": "93:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181197,
          "resource_id": 33,
          "text": "Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."
        }
      ]
    },
    {
      "id": 6085,
      "verse_number": 6,
      "verse_key": "93:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181199,
          "resource_id": 33,
          "text": "Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu)."
        }
      ]
    },
    {
      "id": 6086,
      "verse_number": 7,
      "verse_key": "93:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181201,
          "resource_id": 33,
          "text": "Dan Dia mendapatimu sebagai seorang yang bingung,<sup foot_note=135863>1</sup> lalu Dia memberikan petunjuk."
        }
      ]
    },
    {
      "id": 6087,
      "verse_number": 8,
      "verse_key": "93:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181203,
          "resource_id": 33,
          "text": "Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan."
        }
      ]
    },
    {
      "id": 6088,
      "verse_number": 9,
      "verse_key": "93:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 181206,
          "resource_id": 33,
          "text": "Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang."
        }
      ]
    },
    {
      "id": 6089,
      "verse_number": 10,
      "verse_key": "93:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 177510,
          "resource_id": 33,
          "text": "Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya)."
        }
      ]
    },
    {
      "id": 6090,
      "verse_number": 11,
      "verse_key": "93:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "chapter_id": 93,
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 177514,
          "resource_id": 33,
          "text": "Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur)."
        }
      ]
    }
  ],
