      "verse_key": "107:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 177228,
          "resource_id": 33,
          "text": "Tahukah kamu (orang) yang mendustakan agama?"
        }
      ]
    },
    {
      "id": 6199,
      "verse_number": 2,
      "verse_key": "107:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181406,
          "resource_id": 33,
          "text": "Maka itulah orang yang menghardik anak yatim,"
        }
      ]
    },
    {
      "id": 6200,
      "verse_number": 3,
      "verse_key": "107:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181407,
          "resource_id": 33,
          "text": "dan tidak mengajak memberi makan orang miskin."
        }
      ]
    },
    {
      "id": 6201,
      "verse_number": 4,
      "verse_key": "107:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181409,
          "resource_id": 33,
          "text": "Maka celakalah orang yang salat,"
        }
      ]
    },
    {
      "id": 6202,
      "verse_number": 5,
      "verse_key": "107:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181408,
          "resource_id": 33,
          "text": "(yaitu) orang-orang yang lalai terhadap salatnya,<sup foot_note=135878>1</sup>"
        }
      ]
    },
    {
      "id": 6203,
      "verse_number": 6,
      "verse_key": "107:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181396,
          "resource_id": 33,
          "text": "yang berbuat riya`,<sup foot_note=135879>1</sup>"
        }
      ]
    },
    {
      "id": 6204,
      "verse_number": 7,
      "verse_key": "107:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181415,
          "resource_id": 33,
          "text": "dan enggan (memberikan) bantuan.<sup foot_note=135880>1</sup>"
        }
      ]
    }
