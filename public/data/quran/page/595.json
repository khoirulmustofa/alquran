{
  "verses": [
    {
      "id": 6044,
      "verse_number": 1,
      "verse_key": "91:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلشَّمْسِ وَضُحَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181117,
          "resource_id": 33,
          "text": "Demi matahari dan sinarnya pada pagi hari,"
        }
      ]
    },
    {
      "id": 6045,
      "verse_number": 2,
      "verse_key": "91:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181131,
          "resource_id": 33,
          "text": "demi bulan apabila mengiringinya,"
        }
      ]
    },
    {
      "id": 6046,
      "verse_number": 3,
      "verse_key": "91:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 183013,
          "resource_id": 33,
          "text": "demi siang apabila menampakkannya,"
        }
      ]
    },
    {
      "id": 6047,
      "verse_number": 4,
      "verse_key": "91:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181144,
          "resource_id": 33,
          "text": "demi malam apabila menutupinya (gelap gulita),"
        }
      ]
    },
    {
      "id": 6048,
      "verse_number": 5,
      "verse_key": "91:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 177506,
          "resource_id": 33,
          "text": "demi langit serta perancangannya (yang menakjubkan),"
        }
      ]
    },
    {
      "id": 6049,
      "verse_number": 6,
      "verse_key": "91:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181149,
          "resource_id": 33,
          "text": "demi bumi serta penghamparannya,"
        }
      ]
    },
    {
      "id": 6050,
      "verse_number": 7,
      "verse_key": "91:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181146,
          "resource_id": 33,
          "text": "demi jiwa serta penyempurnaan (ciptaan)nya,"
        }
      ]
    },
    {
      "id": 6051,
      "verse_number": 8,
      "verse_key": "91:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181151,
          "resource_id": 33,
          "text": "maka Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,"
        }
      ]
    },
    {
      "id": 6052,
      "verse_number": 9,
      "verse_key": "91:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181153,
          "resource_id": 33,
          "text": "sungguh beruntung orang yang menyucikannya (jiwa itu),"
        }
      ]
    },
    {
      "id": 6053,
      "verse_number": 10,
      "verse_key": "91:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181114,
          "resource_id": 33,
          "text": "dan sungguh rugi orang yang mengotorinya."
        }
      ]
    },
    {
      "id": 6054,
      "verse_number": 11,
      "verse_key": "91:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 177504,
          "resource_id": 33,
          "text": "(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas (zalim),"
        }
      ]
    },
    {
      "id": 6055,
      "verse_number": 12,
      "verse_key": "91:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181119,
          "resource_id": 33,
          "text": "ketika bangkit orang yang paling celaka di antara mereka,"
        }
      ]
    },
    {
      "id": 6056,
      "verse_number": 13,
      "verse_key": "91:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181121,
          "resource_id": 33,
          "text": "lalu Rasul Allah (Saleh) berkata kepada mereka, \"(Biarkanlah) unta betina dari Allah ini dengan minumannya.\""
        }
      ]
    },
    {
      "id": 6057,
      "verse_number": 14,
      "verse_key": "91:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181126,
          "resource_id": 33,
          "text": "Namun mereka mendustakannya dan menyembelihnya, karena itu Tuhan membinasakan mereka karena dosanya, lalu diratakan-Nya (dengan tanah)."
        }
      ]
    },
    {
      "id": 6058,
      "verse_number": 15,
      "verse_key": "91:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَخَافُ عُقْبَـٰهَا",
      "chapter_id": 91,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181123,
          "resource_id": 33,
          "text": "Dan Dia tidak takut terhadap akibatnya."
        }
      ]
    },
    {
      "id": 6059,
      "verse_number": 1,
      "verse_key": "92:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181156,
          "resource_id": 33,
          "text": "Demi malam apabila menutupi (cahaya siang),"
        }
      ]
    },
    {
      "id": 6060,
      "verse_number": 2,
      "verse_key": "92:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181167,
          "resource_id": 33,
          "text": "demi siang bila terang benderang,"
        }
      ]
    },
    {
      "id": 6061,
      "verse_number": 3,
      "verse_key": "92:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181173,
          "resource_id": 33,
          "text": "demi penciptaan laki-laki dan perempuan,"
        }
      ]
    },
    {
      "id": 6062,
      "verse_number": 4,
      "verse_key": "92:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181175,
          "resource_id": 33,
          "text": "sungguh, usahamu memang beraneka macam."
        }
      ]
    },
    {
      "id": 6063,
      "verse_number": 5,
      "verse_key": "92:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181177,
          "resource_id": 33,
          "text": "Maka barangsiapa memberikan (hartanya di jalan Allah) dan bertakwa,"
        }
      ]
    },
    {
      "id": 6064,
      "verse_number": 6,
      "verse_key": "92:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181179,
          "resource_id": 33,
          "text": "dan membenarkan (adanya pahala) yang terbaik (surga),"
        }
      ]
    },
    {
      "id": 6065,
      "verse_number": 7,
      "verse_key": "92:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181181,
          "resource_id": 33,
          "text": "maka akan Kami mudahkan baginya jalan menuju kemudahan (kebahagiaan)."
        }
      ]
    },
    {
      "id": 6066,
      "verse_number": 8,
      "verse_key": "92:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181183,
          "resource_id": 33,
          "text": "Dan adapun orang yang kikir dan merasa dirinya cukup (tidak perlu pertolongan Allah),"
        }
      ]
    },
    {
      "id": 6067,
      "verse_number": 9,
      "verse_key": "92:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181185,
          "resource_id": 33,
          "text": "serta mendustakan (pahala) yang terbaik,"
        }
      ]
    },
    {
      "id": 6068,
      "verse_number": 10,
      "verse_key": "92:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181171,
          "resource_id": 33,
          "text": "maka akan Kami mudahkan baginya jalan menuju kesukaran (kesengsaraan)."
        }
      ]
    },
    {
      "id": 6069,
      "verse_number": 11,
      "verse_key": "92:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181157,
          "resource_id": 33,
          "text": "Dan hartanya tidak bermanfaat baginya apabila dia telah binasa."
        }
      ]
    },
    {
      "id": 6070,
      "verse_number": 12,
      "verse_key": "92:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181158,
          "resource_id": 33,
          "text": "Sesungguhnya Kami lah yang memberi petunjuk,"
        }
      ]
    },
    {
      "id": 6071,
      "verse_number": 13,
      "verse_key": "92:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181159,
          "resource_id": 33,
          "text": "dan sesungguhnya milik Kami lah akhirat dan dunia."
        }
      ]
    },
    {
      "id": 6072,
      "verse_number": 14,
      "verse_key": "92:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "chapter_id": 92,
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 181160,
          "resource_id": 33,
          "text": "Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 26,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 26
  }
}