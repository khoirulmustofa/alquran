{
  "verses": [
    {
      "id": 4896,
      "verse_number": 50,
      "verse_key": "54:50",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌ كَلَمْحٍۭ بِٱلْبَصَرِ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179492,
          "resource_id": 33,
          "text": "Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata."
        }
      ]
    },
    {
      "id": 4897,
      "verse_number": 51,
      "verse_key": "54:51",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179494,
          "resource_id": 33,
          "text": "Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?"
        }
      ]
    },
    {
      "id": 4898,
      "verse_number": 52,
      "verse_key": "54:52",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُلُّ شَىْءٍ فَعَلُوهُ فِى ٱلزُّبُرِ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179500,
          "resource_id": 33,
          "text": "Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan."
        }
      ]
    },
    {
      "id": 4899,
      "verse_number": 53,
      "verse_key": "54:53",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179496,
          "resource_id": 33,
          "text": "Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis."
        }
      ]
    },
    {
      "id": 4900,
      "verse_number": 54,
      "verse_key": "54:54",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَهَرٍ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179497,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,"
        }
      ]
    },
    {
      "id": 4901,
      "verse_number": 55,
      "verse_key": "54:55",
      "hizb_number": 53,
      "rub_el_hizb_number": 212,
      "ruku_number": 467,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍۭ",
      "chapter_id": 54,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179498,
          "resource_id": 33,
          "text": "di tempat yang disenangi di sisi Tuhan Yang Mahakuasa."
        }
      ]
    },
    {
      "id": 4902,
      "verse_number": 1,
      "verse_key": "55:1",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱلرَّحْمَـٰنُ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 177529,
          "resource_id": 33,
          "text": "(Allah) Yang Maha Pengasih,"
        }
      ]
    },
    {
      "id": 4903,
      "verse_number": 2,
      "verse_key": "55:2",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْقُرْءَانَ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 177423,
          "resource_id": 33,
          "text": "Yang telah mengajarkan Alquran."
        }
      ]
    },
    {
      "id": 4904,
      "verse_number": 3,
      "verse_key": "55:3",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179537,
          "resource_id": 33,
          "text": "Dia menciptakan manusia,"
        }
      ]
    },
    {
      "id": 4905,
      "verse_number": 4,
      "verse_key": "55:4",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَهُ ٱلْبَيَانَ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179556,
          "resource_id": 33,
          "text": "mengajarnya pandai berbicara."
        }
      ]
    },
    {
      "id": 4906,
      "verse_number": 5,
      "verse_key": "55:5",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179562,
          "resource_id": 33,
          "text": "Matahari dan bulan beredar menurut perhitungan,"
        }
      ]
    },
    {
      "id": 4907,
      "verse_number": 6,
      "verse_key": "55:6",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179759,
          "resource_id": 33,
          "text": "Bintang dan pepohonan, keduanya tunduk (kepada-Nya)."
        }
      ]
    },
    {
      "id": 4908,
      "verse_number": 7,
      "verse_key": "55:7",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179582,
          "resource_id": 33,
          "text": "Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,"
        }
      ]
    },
    {
      "id": 4909,
      "verse_number": 8,
      "verse_key": "55:8",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179589,
          "resource_id": 33,
          "text": "agar kamu jangan merusak keseimbangan itu."
        }
      ]
    },
    {
      "id": 4910,
      "verse_number": 9,
      "verse_key": "55:9",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179591,
          "resource_id": 33,
          "text": "Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu."
        }
      ]
    },
    {
      "id": 4911,
      "verse_number": 10,
      "verse_key": "55:10",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179794,
          "resource_id": 33,
          "text": "Dan bumi telah dibentangkan-Nya untuk makhluk(-Nya),"
        }
      ]
    },
    {
      "id": 4912,
      "verse_number": 11,
      "verse_key": "55:11",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179764,
          "resource_id": 33,
          "text": "di dalamnya ada buah-buahan dan pohon kurma yang mempunyai kelopak mayang,"
        }
      ]
    },
    {
      "id": 4913,
      "verse_number": 12,
      "verse_key": "55:12",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179516,
          "resource_id": 33,
          "text": "dan biji-bijian yang berkulit dan bunga-bunga yang harum baunya."
        }
      ]
    },
    {
      "id": 4914,
      "verse_number": 13,
      "verse_key": "55:13",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179524,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4915,
      "verse_number": 14,
      "verse_key": "55:14",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179517,
          "resource_id": 33,
          "text": "Dia menciptakan manusia dari tanah kering seperti tembikar,"
        }
      ]
    },
    {
      "id": 4916,
      "verse_number": 15,
      "verse_key": "55:15",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179518,
          "resource_id": 33,
          "text": "dan Dia menciptakan jin dari nyala api tanpa asap."
        }
      ]
    },
    {
      "id": 4917,
      "verse_number": 16,
      "verse_key": "55:16",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 179519,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    }
  ],
