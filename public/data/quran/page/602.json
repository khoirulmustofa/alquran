{
  "verses": [
    {
      "id": 6194,
      "verse_number": 1,
      "verse_key": "106:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لِإِيلَـٰفِ قُرَيْشٍ",
      "chapter_id": 106,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181997,
          "resource_id": 33,
          "text": "Karena kebiasaan orang-orang Quraisy,"
        }
      ]
    },
    {
      "id": 6195,
      "verse_number": 2,
      "verse_key": "106:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
      "chapter_id": 106,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181398,
          "resource_id": 33,
          "text": "(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas.<sup foot_note=135877>1</sup>"
        }
      ]
    },
    {
      "id": 6196,
      "verse_number": 3,
      "verse_key": "106:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ",
      "chapter_id": 106,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181347,
          "resource_id": 33,
          "text": "Maka hendaklah mereka menyembah Tuhan (pemilik) rumah ini (Ka'bah),"
        }
      ]
    },
    {
      "id": 6197,
      "verse_number": 4,
      "verse_key": "106:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
      "chapter_id": 106,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181375,
          "resource_id": 33,
          "text": "yang telah memberi makanan kepada mereka untuk menghilangkan lapar dan mengamankan mereka dari rasa ketakutan."
        }
      ]
    },
    {
      "id": 6198,
      "verse_number": 1,
      "verse_key": "107:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 177228,
          "resource_id": 33,
          "text": "Tahukah kamu (orang) yang mendustakan agama?"
        }
      ]
    },
    {
      "id": 6199,
      "verse_number": 2,
      "verse_key": "107:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181406,
          "resource_id": 33,
          "text": "Maka itulah orang yang menghardik anak yatim,"
        }
      ]
    },
    {
      "id": 6200,
      "verse_number": 3,
      "verse_key": "107:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181407,
          "resource_id": 33,
          "text": "dan tidak mengajak memberi makan orang miskin."
        }
      ]
    },
    {
      "id": 6201,
      "verse_number": 4,
      "verse_key": "107:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181409,
          "resource_id": 33,
          "text": "Maka celakalah orang yang salat,"
        }
      ]
    },
    {
      "id": 6202,
      "verse_number": 5,
      "verse_key": "107:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181408,
          "resource_id": 33,
          "text": "(yaitu) orang-orang yang lalai terhadap salatnya,<sup foot_note=135878>1</sup>"
        }
      ]
    },
    {
      "id": 6203,
      "verse_number": 6,
      "verse_key": "107:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181396,
          "resource_id": 33,
          "text": "yang berbuat riya`,<sup foot_note=135879>1</sup>"
        }
      ]
    },
    {
      "id": 6204,
      "verse_number": 7,
      "verse_key": "107:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "chapter_id": 107,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181415,
          "resource_id": 33,
          "text": "dan enggan (memberikan) bantuan.<sup foot_note=135880>1</sup>"
        }
      ]
    },
    {
      "id": 6205,
      "verse_number": 1,
      "verse_key": "108:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 552,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ",
      "chapter_id": 108,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181421,
          "resource_id": 33,
          "text": "Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak."
        }
      ]
    },
    {
      "id": 6206,
      "verse_number": 2,
      "verse_key": "108:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 552,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ",
      "chapter_id": 108,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181428,
          "resource_id": 33,
          "text": "Maka laksanakanlah salat karena Tuhanmu, dan berkurbanlah (sebagai ibadah dan mendekatkan diri kepada Allah)."
        }
      ]
    },
    {
      "id": 6207,
      "verse_number": 3,
      "verse_key": "108:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 552,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ",
      "chapter_id": 108,
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 181424,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang membencimu dialah yang terputus (dari rahmat Allah)."
        }
      ]
    }
  ],
