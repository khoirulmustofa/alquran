{
  "verses": [
    {
      "id": 5030,
      "verse_number": 51,
      "verse_key": "56:51",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179637,
          "resource_id": 33,
          "text": "Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!"
        }
      ]
    },
    {
      "id": 5031,
      "verse_number": 52,
      "verse_key": "56:52",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 177425,
          "resource_id": 33,
          "text": "pasti akan memakan pohon zaqqum,<sup foot_note=135780>1</sup>"
        }
      ]
    },
    {
      "id": 5032,
      "verse_number": 53,
      "verse_key": "56:53",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 177427,
          "resource_id": 33,
          "text": "Maka akan penuh perutmu dengannya."
        }
      ]
    },
    {
      "id": 5033,
      "verse_number": 54,
      "verse_key": "56:54",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 177429,
          "resource_id": 33,
          "text": "Setelah itu kamu akan memimun air yang sangat panas."
        }
      ]
    },
    {
      "id": 5034,
      "verse_number": 55,
      "verse_key": "56:55",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179638,
          "resource_id": 33,
          "text": "Maka kamu minum seperti unta (yang sangat haus) minum."
        }
      ]
    },
    {
      "id": 5035,
      "verse_number": 56,
      "verse_key": "56:56",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179639,
          "resource_id": 33,
          "text": "Itulah hidangan untuk mereka pada hari pembalasan.\""
        }
      ]
    },
    {
      "id": 5036,
      "verse_number": 57,
      "verse_key": "56:57",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179640,
          "resource_id": 33,
          "text": "Kami telah menciptakan kamu, mengapa kamu tidak membenarkan (hari berbangkit)?"
        }
      ]
    },
    {
      "id": 5037,
      "verse_number": 58,
      "verse_key": "56:58",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179641,
          "resource_id": 33,
          "text": "Maka adakah kamu perhatikan, tentang (benih manusia) yang kamu pancarkan."
        }
      ]
    },
    {
      "id": 5038,
      "verse_number": 59,
      "verse_key": "56:59",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179642,
          "resource_id": 33,
          "text": "Kamukah yang menciptakannya, ataukah Kami penciptanya?"
        }
      ]
    },
    {
      "id": 5039,
      "verse_number": 60,
      "verse_key": "56:60",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179646,
          "resource_id": 33,
          "text": "Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,"
        }
      ]
    },
    {
      "id": 5040,
      "verse_number": 61,
      "verse_key": "56:61",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179645,
          "resource_id": 33,
          "text": "untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui."
        }
      ]
    },
    {
      "id": 5041,
      "verse_number": 62,
      "verse_key": "56:62",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179647,
          "resource_id": 33,
          "text": "Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?"
        }
      ]
    },
    {
      "id": 5042,
      "verse_number": 63,
      "verse_key": "56:63",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 181722,
          "resource_id": 33,
          "text": "Pernahkah kamu perhatikan benih yang kamu tanam?"
        }
      ]
    },
    {
      "id": 5043,
      "verse_number": 64,
      "verse_key": "56:64",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179648,
          "resource_id": 33,
          "text": "Kamukah yang menumbuhkannya ataukah Kami yang menumbuhkan?"
        }
      ]
    },
    {
      "id": 5044,
      "verse_number": 65,
      "verse_key": "56:65",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179649,
          "resource_id": 33,
          "text": "Sekiranya Kami kehendaki, niscaya Kami hancurkan sampai lumat; maka kamu akan heran tercengang,"
        }
      ]
    },
    {
      "id": 5045,
      "verse_number": 66,
      "verse_key": "56:66",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا لَمُغْرَمُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179650,
          "resource_id": 33,
          "text": "(sambil berkata), \"Sungguh, kami benar-benar menderita kerugian,"
        }
      ]
    },
    {
      "id": 5046,
      "verse_number": 67,
      "verse_key": "56:67",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179653,
          "resource_id": 33,
          "text": "bahkan kami tidak mendapat hasil apa pun.\""
        }
      ]
    },
    {
      "id": 5047,
      "verse_number": 68,
      "verse_key": "56:68",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179651,
          "resource_id": 33,
          "text": "Pernahkah kamu memperhatikan air yang kamu minum?"
        }
      ]
    },
    {
      "id": 5048,
      "verse_number": 69,
      "verse_key": "56:69",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 177065,
          "resource_id": 33,
          "text": "Kamukah yang menurunkannya dari awan ataukah Kami yang menurunkan?"
        }
      ]
    },
    {
      "id": 5049,
      "verse_number": 70,
      "verse_key": "56:70",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179654,
          "resource_id": 33,
          "text": "Sekiranya Kami menghendaki, niscaya Kami menjadikannya asin, mengapa kamu tidak bersyukur?"
        }
      ]
    },
    {
      "id": 5050,
      "verse_number": 71,
      "verse_key": "56:71",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179655,
          "resource_id": 33,
          "text": "Maka pernahkah kamu memperhatikan tentang api yang kamu nyalakan (dengan kayu)?"
        }
      ]
    },
    {
      "id": 5051,
      "verse_number": 72,
      "verse_key": "56:72",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179656,
          "resource_id": 33,
          "text": "Kamukah yang menumbuhkan kayu itu ataukah Kami yang menumbuhkan?"
        }
      ]
    },
    {
      "id": 5052,
      "verse_number": 73,
      "verse_key": "56:73",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179657,
          "resource_id": 33,
          "text": "Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir."
        }
      ]
    },
    {
      "id": 5053,
      "verse_number": 74,
      "verse_key": "56:74",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179658,
          "resource_id": 33,
          "text": "Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar."
        }
      ]
    },
    {
      "id": 5054,
      "verse_number": 75,
      "verse_key": "56:75",
      "hizb_number": 54,
      "rub_el_hizb_number": 215,
      "ruku_number": 473,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179659,
          "resource_id": 33,
          "text": "Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang."
        }
      ]
    },
    {
      "id": 5055,
      "verse_number": 76,
      "verse_key": "56:76",
      "hizb_number": 54,
      "rub_el_hizb_number": 215,
      "ruku_number": 473,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "chapter_id": 56,
      "page_number": 536,
      "juz_number": 27,
      "translations": [
        {
          "id": 179660,
          "resource_id": 33,
          "text": "Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 26,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
