{
  "verses": [
    {
      "id": 4969,
      "verse_number": 68,
      "verse_key": "55:68",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179593,
          "resource_id": 33,
          "text": "Di dalam kedua surga itu ada buah-buahan, kurma dan delima."
        }
      ]
    },
    {
      "id": 4970,
      "verse_number": 69,
      "verse_key": "55:69",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179576,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4971,
      "verse_number": 70,
      "verse_key": "55:70",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179577,
          "resource_id": 33,
          "text": "Di dalam surga-surga itu ada bidadari-bidadari yang baik-baik dan jelita."
        }
      ]
    },
    {
      "id": 4972,
      "verse_number": 71,
      "verse_key": "55:71",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179578,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4973,
      "verse_number": 72,
      "verse_key": "55:72",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179579,
          "resource_id": 33,
          "text": "Bidadari-bidadari yang dipelihara di dalam kemah-kemah."
        }
      ]
    },
    {
      "id": 4974,
      "verse_number": 73,
      "verse_key": "55:73",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179580,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4975,
      "verse_number": 74,
      "verse_key": "55:74",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179581,
          "resource_id": 33,
          "text": "Mereka sebelumnya tidak pernah disentuh oleh manusia maupun oleh jin."
        }
      ]
    },
    {
      "id": 4976,
      "verse_number": 75,
      "verse_key": "55:75",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179587,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4977,
      "verse_number": 76,
      "verse_key": "55:76",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179583,
          "resource_id": 33,
          "text": "Mereka bersandar pada bantal-bantal yang hijau dan permadani-permadani yang indah."
        }
      ]
    },
    {
      "id": 4978,
      "verse_number": 77,
      "verse_key": "55:77",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179584,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4979,
      "verse_number": 78,
      "verse_key": "55:78",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 470,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "chapter_id": 55,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179585,
          "resource_id": 33,
          "text": "Mahasuci nama Tuhanmu Pemilik Keagungan dan Kemuliaan."
        }
      ]
    },
    {
      "id": 4980,
      "verse_number": 1,
      "verse_key": "56:1",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179595,
          "resource_id": 33,
          "text": "Apabila terjadi hari Kiamat,"
        }
      ]
    },
    {
      "id": 4981,
      "verse_number": 2,
      "verse_key": "56:2",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179606,
          "resource_id": 33,
          "text": "terjadinya tidak dapat didustakan (disangkal)."
        }
      ]
    },
    {
      "id": 4982,
      "verse_number": 3,
      "verse_key": "56:3",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَافِضَةٌ رَّافِعَةٌ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179635,
          "resource_id": 33,
          "text": "(Kejadian itu) merendahkan (satu golongan) dan meninggikan (golongan yang lain)."
        }
      ]
    },
    {
      "id": 4983,
      "verse_number": 4,
      "verse_key": "56:4",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179625,
          "resource_id": 33,
          "text": "Apabila bumi diguncangkan sedahsyat-dahsyatnya,"
        }
      ]
    },
    {
      "id": 4984,
      "verse_number": 5,
      "verse_key": "56:5",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179644,
          "resource_id": 33,
          "text": "dan gunung-gunung dihancur luluhkan sehancur-hancurnya,"
        }
      ]
    },
    {
      "id": 4985,
      "verse_number": 6,
      "verse_key": "56:6",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179701,
          "resource_id": 33,
          "text": "maka jadilah ia debu yang berterbangan,"
        }
      ]
    },
    {
      "id": 4986,
      "verse_number": 7,
      "verse_key": "56:7",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179665,
          "resource_id": 33,
          "text": "dan kamu menjadi tiga golongan,"
        }
      ]
    },
    {
      "id": 4987,
      "verse_number": 8,
      "verse_key": "56:8",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179677,
          "resource_id": 33,
          "text": "yaitu golongan kanan,<sup foot_note=135776>1</sup> alangkah mulianya golongan kanan itu,"
        }
      ]
    },
    {
      "id": 4988,
      "verse_number": 9,
      "verse_key": "56:9",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179683,
          "resource_id": 33,
          "text": "dan golongan kiri,<sup foot_note=135777>1</sup> alangkah sengsaranya golongan kiri itu,"
        }
      ]
    },
    {
      "id": 4989,
      "verse_number": 10,
      "verse_key": "56:10",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179709,
          "resource_id": 33,
          "text": "dan orang-orang yang paling dahulu (beriman), merekalah yang paling dahulu (masuk surga)."
        }
      ]
    },
    {
      "id": 4990,
      "verse_number": 11,
      "verse_key": "56:11",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179617,
          "resource_id": 33,
          "text": "mereka itulah orang yang dekat (kepada Allah),"
        }
      ]
    },
    {
      "id": 4991,
      "verse_number": 12,
      "verse_key": "56:12",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179604,
          "resource_id": 33,
          "text": "Berada dalam surga kenikmatan,"
        }
      ]
    },
    {
      "id": 4992,
      "verse_number": 13,
      "verse_key": "56:13",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179596,
          "resource_id": 33,
          "text": "segolongan besar dari orang-orang yang terdahulu,<sup foot_note=135778>1</sup>"
        }
      ]
    },
    {
      "id": 4993,
      "verse_number": 14,
      "verse_key": "56:14",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179597,
          "resource_id": 33,
          "text": "dan segolongan kecil dari orang-orang yang kemudian."
        }
      ]
    },
    {
      "id": 4994,
      "verse_number": 15,
      "verse_key": "56:15",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179598,
          "resource_id": 33,
          "text": "mereka berada di atas dipan-dipan yang bertahtakan emas dan permata,"
        }
      ]
    },
    {
      "id": 4995,
      "verse_number": 16,
      "verse_key": "56:16",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ",
      "chapter_id": 56,
      "page_number": 534,
      "juz_number": 27,
      "translations": [
        {
          "id": 179599,
          "resource_id": 33,
          "text": "mereka bersandar di atasnya berhadap-hadapan."
        }
      ]
    }
  ],
