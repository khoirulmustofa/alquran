{
  "verses": [
    {
      "id": 3069,
      "verse_number": 137,
      "verse_key": "26:137",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنْ هَـٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183298,
          "resource_id": 33,
          "text": "(agama kami) ini tidak lain hanyalah adat kebiasaan orang-orang terdahulu,"
        }
      ]
    },
    {
      "id": 3070,
      "verse_number": 138,
      "verse_key": "26:138",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَا نَحْنُ بِمُعَذَّبِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181713,
          "resource_id": 33,
          "text": "dan kami (sama sekali) tidak akan di azab.\""
        }
      ]
    },
    {
      "id": 3071,
      "verse_number": 139,
      "verse_key": "26:139",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبُوهُ فَأَهْلَكْنَـٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183299,
          "resource_id": 33,
          "text": "Maka mereka mendustakannya (Hud), lalu Kami binasakan mereka. Sungguh, pada yang demikian itu terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman."
        }
      ]
    },
    {
      "id": 3072,
      "verse_number": 140,
      "verse_key": "26:140",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181714,
          "resource_id": 33,
          "text": "Dan sungguh, Tuhanmu, Dialah Yang Mahaperkasa, Maha Penyayang."
        }
      ]
    },
    {
      "id": 3073,
      "verse_number": 141,
      "verse_key": "26:141",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183301,
          "resource_id": 33,
          "text": "Kaum Samud telah mendustakan para rasul."
        }
      ]
    },
    {
      "id": 3074,
      "verse_number": 142,
      "verse_key": "26:142",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَـٰلِحٌ أَلَا تَتَّقُونَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181717,
          "resource_id": 33,
          "text": "Ketika saudara mereka Saleh berkata kepada mereka, \"Mengapa kamu tidak bertakwa?"
        }
      ]
    },
    {
      "id": 3075,
      "verse_number": 143,
      "verse_key": "26:143",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183302,
          "resource_id": 33,
          "text": "Sungguh, aku ini seorang rasul kepercayaan (yang diutus) kepadamu,"
        }
      ]
    },
    {
      "id": 3076,
      "verse_number": 144,
      "verse_key": "26:144",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183300,
          "resource_id": 33,
          "text": "maka bertakwalah kepada Allah dan taatlah kepadaku."
        }
      ]
    },
    {
      "id": 3077,
      "verse_number": 145,
      "verse_key": "26:145",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183296,
          "resource_id": 33,
          "text": "Dan aku tidak meminta sesuatu imbalan kepadamu atas ajakan ini, imbalanku hanyalah dari Tuhan seluruh alam."
        }
      ]
    },
    {
      "id": 3078,
      "verse_number": 146,
      "verse_key": "26:146",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "أَتُتْرَكُونَ فِى مَا هَـٰهُنَآ ءَامِنِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181718,
          "resource_id": 33,
          "text": "Apakah kamu (mengira) akan dibiarkan tinggal di sini (di negeri kamu ini) dengan aman,"
        }
      ]
    },
    {
      "id": 3079,
      "verse_number": 147,
      "verse_key": "26:147",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّـٰتٍ وَعُيُونٍ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183305,
          "resource_id": 33,
          "text": "di dalam kebun-kebun dan mata air,"
        }
      ]
    },
    {
      "id": 3080,
      "verse_number": 148,
      "verse_key": "26:148",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضِيمٌ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181720,
          "resource_id": 33,
          "text": "dan tanaman-tanaman dan pohon-pohon kurma yang mayangnya lembut."
        }
      ]
    },
    {
      "id": 3081,
      "verse_number": 149,
      "verse_key": "26:149",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا فَـٰرِهِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183304,
          "resource_id": 33,
          "text": "Dan kamu pahat dengan terampil sebagian gunung-gunung untuk dijadikan rumah-rumah;"
        }
      ]
    },
    {
      "id": 3082,
      "verse_number": 150,
      "verse_key": "26:150",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181721,
          "resource_id": 33,
          "text": "maka bertakwalah kepada Allah dan taatlah kepadaku;"
        }
      ]
    },
    {
      "id": 3083,
      "verse_number": 151,
      "verse_key": "26:151",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183308,
          "resource_id": 33,
          "text": "dan janganlah kamu menaati perintah orang-orang yang melampaui batas,"
        }
      ]
    },
    {
      "id": 3084,
      "verse_number": 152,
      "verse_key": "26:152",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181724,
          "resource_id": 33,
          "text": "yang berbuat kerusakan di bumi dan tidak mengadakan perbaikan.\""
        }
      ]
    },
    {
      "id": 3085,
      "verse_number": 153,
      "verse_key": "26:153",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183306,
          "resource_id": 33,
          "text": "Mereka berkata, \"Sungguh, engkau hanyalah termasuk orang yang kena sihir;"
        }
      ]
    },
    {
      "id": 3086,
      "verse_number": 154,
      "verse_key": "26:154",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "مَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 181725,
          "resource_id": 33,
          "text": "engkau hanyalah manusia seperti kami; maka datangkanlah suatu mukjizat jika engkau termasuk orang yang benar.\""
        }
      ]
    },
    {
      "id": 3087,
      "verse_number": 155,
      "verse_key": "26:155",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ هَـٰذِهِۦ نَاقَةٌ لَّهَا شِرْبٌ وَلَكُمْ شِرْبُ يَوْمٍ مَّعْلُومٍ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183303,
          "resource_id": 33,
          "text": "Dia (Saleh) menjawab, \"Ini seekor unta betina, yang berhak mendapatkan (giliran) minum, dan kamu juga berhak mendapatkan minum pada hari yang ditentukan."
        }
      ]
    },
    {
      "id": 3088,
      "verse_number": 156,
      "verse_key": "26:156",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183295,
          "resource_id": 33,
          "text": "Dan jangan kamu menyentuhnya (unta itu) dengan jahat, nanti kamu akan ditimpa azab pada hari yang dahsyat.\""
        }
      ]
    },
    {
      "id": 3089,
      "verse_number": 157,
      "verse_key": "26:157",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَعَقَرُوهَا فَأَصْبَحُوا۟ نَـٰدِمِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183312,
          "resource_id": 33,
          "text": "Kemudian mereka membunuhnya, lalu mereka merasa menyesal,"
        }
      ]
    },
    {
      "id": 3090,
      "verse_number": 158,
      "verse_key": "26:158",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183313,
          "resource_id": 33,
          "text": "maka mereka ditimpa azab. Sungguh, pada yang demikian itu terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman."
        }
      ]
    },
    {
      "id": 3091,
      "verse_number": 159,
      "verse_key": "26:159",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 323,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "chapter_id": 26,
      "page_number": 373,
      "juz_number": 19,
      "translations": [
        {
          "id": 183311,
          "resource_id": 33,
          "text": "Dan sungguh, Tuhanmu, Dialah Yang Mahaperkasa, Maha Penyayang."
        }
      ]
    }
  ],
