{
  "verses": [
    {
      "id": 2346,
      "verse_number": 96,
      "verse_key": "19:96",
      "hizb_number": 31,
      "rub_el_hizb_number": 124,
      "ruku_number": 269,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَـٰنُ وُدًّا",
      "chapter_id": 19,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182256,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, kelak (Allah) Yang Maha Pengasih akan menanamkan rasa kasih sayang (dalam hati mereka)."
        }
      ]
    },
    {
      "id": 2347,
      "verse_number": 97,
      "verse_key": "19:97",
      "hizb_number": 31,
      "rub_el_hizb_number": 124,
      "ruku_number": 269,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًا لُّدًّا",
      "chapter_id": 19,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182255,
          "resource_id": 33,
          "text": "Maka sungguh, telah Kami mudahkan (Alquran) itu dengan bahasamu (Muhammad), agar dengan itu engkau dapat memberi kabar gembira kepada orang-orang yang bertakwa, dan agar engkau dapat memberi peringatan kepada kaum yang membangkang."
        }
      ]
    },
    {
      "id": 2348,
      "verse_number": 98,
      "verse_key": "19:98",
      "hizb_number": 31,
      "rub_el_hizb_number": 124,
      "ruku_number": 269,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا",
      "chapter_id": 19,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182301,
          "resource_id": 33,
          "text": "Dan berapa banyak umat yang telah Kami binasakan sebelum mereka. Adakah engkau (Muhammad) melihat salah seorang dari mereka atau engkau mendengar bisikan mereka?"
        }
      ]
    },
    {
      "id": 2349,
      "verse_number": 1,
      "verse_key": "20:1",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": " طه",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182261,
          "resource_id": 33,
          "text": "Ṭāhā."
        }
      ]
    },
    {
      "id": 2350,
      "verse_number": 2,
      "verse_key": "20:2",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182302,
          "resource_id": 33,
          "text": "Kami tidak menurunkan Alquran ini kepadamu (Muhammad) agar engkau menjadi susah;"
        }
      ]
    },
    {
      "id": 2351,
      "verse_number": 3,
      "verse_key": "20:3",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا تَذْكِرَةً لِّمَن يَخْشَىٰ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182316,
          "resource_id": 33,
          "text": "melainkan sebagai peringatan bagi orang yang takut (kepada Allah),"
        }
      ]
    },
    {
      "id": 2352,
      "verse_number": 4,
      "verse_key": "20:4",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "تَنزِيلًا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَـٰوَٰتِ ٱلْعُلَى",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182324,
          "resource_id": 33,
          "text": "diturunkan dari (Allah) yang menciptakan bumi dan langit yang tinggi,"
        }
      ]
    },
    {
      "id": 2353,
      "verse_number": 5,
      "verse_key": "20:5",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ٱلرَّحْمَـٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182343,
          "resource_id": 33,
          "text": "(yaitu) Yang Maha Pengasih, yang bersemayam di atas Arasy.<sup foot_note=135460>1</sup>"
        }
      ]
    },
    {
      "id": 2354,
      "verse_number": 6,
      "verse_key": "20:6",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182341,
          "resource_id": 33,
          "text": "Milik-Nyalah apa yang ada di langit, apa yang ada di bumi, apa yang ada di antara keduanya, dan apa yang ada di bawah tanah."
        }
      ]
    },
    {
      "id": 2355,
      "verse_number": 7,
      "verse_key": "20:7",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182347,
          "resource_id": 33,
          "text": "Dan jika engkau mengeraskan ucapanmu, sungguh, Dia mengetahui rahasia dan yang lebih tersembunyi.<sup foot_note=135461>1</sup>"
        }
      ]
    },
    {
      "id": 2356,
      "verse_number": 8,
      "verse_key": "20:8",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182367,
          "resource_id": 33,
          "text": "(Dialah) Allah, tidak ada tuhan selain Dia, yang mempunyai nama-nama yang terbaik."
        }
      ]
    },
    {
      "id": 2357,
      "verse_number": 9,
      "verse_key": "20:9",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182370,
          "resource_id": 33,
          "text": "Dan apakah telah sampai kepadamu kisah Musa?"
        }
      ]
    },
    {
      "id": 2358,
      "verse_number": 10,
      "verse_key": "20:10",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "إِذْ رَءَا نَارًا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًى",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182243,
          "resource_id": 33,
          "text": "Ketika dia (Musa) melihat api, lalu dia berkata kepada keluarganya, \"Tinggallah kamu (disini), sesungguhnya aku melihat api, mudah-mudahan aku dapat membawa sedikit nyala api kepadamu atau aku akan mendapat petunjuk di tempat api itu.\""
        }
      ]
    },
    {
      "id": 2359,
      "verse_number": 11,
      "verse_key": "20:11",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "فَلَمَّآ أَتَىٰهَا نُودِىَ يَـٰمُوسَىٰٓ",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182272,
          "resource_id": 33,
          "text": "Maka ketika dia mendatanginya (ke tempat api itu) dia dipanggil, \"Wahai Musa!"
        }
      ]
    },
    {
      "id": 2360,
      "verse_number": 12,
      "verse_key": "20:12",
      "hizb_number": 32,
      "rub_el_hizb_number": 125,
      "ruku_number": 270,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "chapter_id": 20,
      "page_number": 312,
      "juz_number": 16,
      "translations": [
        {
          "id": 182281,
          "resource_id": 33,
          "text": "Sungguh, Aku adalah Tuhanmu, maka lepaskan kedua terompahmu. Karena sesungguhnya engkau berada di lembah yang suci, Ṭuwā."
        }
      ]
    }
  ],
