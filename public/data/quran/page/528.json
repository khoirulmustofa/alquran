{
  "verses": [
    {
      "id": 4829,
      "verse_number": 45,
      "verse_key": "53:45",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179417,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,"
        }
      ]
    },
    {
      "id": 4830,
      "verse_number": 46,
      "verse_key": "53:46",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 177539,
          "resource_id": 33,
          "text": "dari mani, apabila dipancarkan,"
        }
      ]
    },
    {
      "id": 4831,
      "verse_number": 47,
      "verse_key": "53:47",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179418,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),"
        }
      ]
    },
    {
      "id": 4832,
      "verse_number": 48,
      "verse_key": "53:48",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179419,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan."
        }
      ]
    },
    {
      "id": 4833,
      "verse_number": 49,
      "verse_key": "53:49",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179420,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'rā,<sup foot_note=135769>1</sup>"
        }
      ]
    },
    {
      "id": 4834,
      "verse_number": 50,
      "verse_key": "53:50",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179423,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang telah membinasakan kaum 'Ād dahulu kala,"
        }
      ]
    },
    {
      "id": 4835,
      "verse_number": 51,
      "verse_key": "53:51",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179424,
          "resource_id": 33,
          "text": "dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),"
        }
      ]
    },
    {
      "id": 4836,
      "verse_number": 52,
      "verse_key": "53:52",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179425,
          "resource_id": 33,
          "text": "dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka."
        }
      ]
    },
    {
      "id": 4837,
      "verse_number": 53,
      "verse_key": "53:53",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179435,
          "resource_id": 33,
          "text": "Dan prahara angin telah meruntuhkan (negeri kaum Luṭ),"
        }
      ]
    },
    {
      "id": 4838,
      "verse_number": 54,
      "verse_key": "53:54",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَغَشَّىٰهَا مَا غَشَّىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179427,
          "resource_id": 33,
          "text": "lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya."
        }
      ]
    },
    {
      "id": 4839,
      "verse_number": 55,
      "verse_key": "53:55",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179428,
          "resource_id": 33,
          "text": "Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?"
        }
      ]
    },
    {
      "id": 4840,
      "verse_number": 56,
      "verse_key": "53:56",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179429,
          "resource_id": 33,
          "text": "Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu."
        }
      ]
    },
    {
      "id": 4841,
      "verse_number": 57,
      "verse_key": "53:57",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَزِفَتِ ٱلْـَٔازِفَةُ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179430,
          "resource_id": 33,
          "text": "Yang dekat (hari Kiamat) telah makin mendekat."
        }
      ]
    },
    {
      "id": 4842,
      "verse_number": 58,
      "verse_key": "53:58",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179431,
          "resource_id": 33,
          "text": "Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah."
        }
      ]
    },
    {
      "id": 4843,
      "verse_number": 59,
      "verse_key": "53:59",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179432,
          "resource_id": 33,
          "text": "Maka apakah kamu merasa heran terhadap pemberitaan ini?"
        }
      ]
    },
    {
      "id": 4844,
      "verse_number": 60,
      "verse_key": "53:60",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَضْحَكُونَ وَلَا تَبْكُونَ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179436,
          "resource_id": 33,
          "text": "dan kamu tertawakan dan tidak menangis,"
        }
      ]
    },
    {
      "id": 4845,
      "verse_number": 61,
      "verse_key": "53:61",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنتُمْ سَـٰمِدُونَ",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 177421,
          "resource_id": 33,
          "text": "sedang kamu lengah (darinya)."
        }
      ]
    },
    {
      "id": 4846,
      "verse_number": 62,
      "verse_key": "53:62",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": 12,
      "text_uthmani": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩",
      "chapter_id": 53,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179437,
          "resource_id": 33,
          "text": "Maka bersujudlah kepada Allah dan sembahlah (Dia)!"
        }
      ]
    },
    {
      "id": 4847,
      "verse_number": 1,
      "verse_key": "54:1",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179448,
          "resource_id": 33,
          "text": "Saat (hari Kiamat) semakin dekat, bulan pun terbelah."
        }
      ]
    },
    {
      "id": 4848,
      "verse_number": 2,
      "verse_key": "54:2",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179461,
          "resource_id": 33,
          "text": "Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\""
        }
      ]
    },
    {
      "id": 4849,
      "verse_number": 3,
      "verse_key": "54:3",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179472,
          "resource_id": 33,
          "text": "Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya."
        }
      ]
    },
    {
      "id": 4850,
      "verse_number": 4,
      "verse_key": "54:4",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179750,
          "resource_id": 33,
          "text": "Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),"
        }
      ]
    },
    {
      "id": 4851,
      "verse_number": 5,
      "verse_key": "54:5",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "حِكْمَةٌۢ بَـٰلِغَةٌ ۖ فَمَا تُغْنِ ٱلنُّذُرُ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179495,
          "resource_id": 33,
          "text": "(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),"
        }
      ]
    },
    {
      "id": 4852,
      "verse_number": 6,
      "verse_key": "54:6",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 465,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ",
      "chapter_id": 54,
      "page_number": 528,
      "juz_number": 27,
      "translations": [
        {
          "id": 179501,
          "resource_id": 33,
          "text": "maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),"
        }
      ]
    }
  ],
