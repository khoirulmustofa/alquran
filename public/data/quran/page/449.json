{
  "verses": [
    {
      "id": 3865,
      "verse_number": 77,
      "verse_key": "37:77",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178317,
          "resource_id": 33,
          "text": "Dan Kami jadikan anak cucunya orang-orang yang melanjutkan keturunan."
        }
      ]
    },
    {
      "id": 3866,
      "verse_number": 78,
      "verse_key": "37:78",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178318,
          "resource_id": 33,
          "text": "Dan Kami abadikan untuk Nuh (pujian) di kalangan orang-orang yang datang kemudian;"
        }
      ]
    },
    {
      "id": 3867,
      "verse_number": 79,
      "verse_key": "37:79",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178319,
          "resource_id": 33,
          "text": "\"Kesejahteraan (Kami limpahkan) atas Nuh di seluruh alam.\""
        }
      ]
    },
    {
      "id": 3868,
      "verse_number": 80,
      "verse_key": "37:80",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178323,
          "resource_id": 33,
          "text": "Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."
        }
      ]
    },
    {
      "id": 3869,
      "verse_number": 81,
      "verse_key": "37:81",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178333,
          "resource_id": 33,
          "text": "Sungguh, dia termasuk di antara hamba-hamba Kami yang beriman."
        }
      ]
    },
    {
      "id": 3870,
      "verse_number": 82,
      "verse_key": "37:82",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178324,
          "resource_id": 33,
          "text": "Kemudian Kami tenggelamkan yang lain."
        }
      ]
    },
    {
      "id": 3871,
      "verse_number": 83,
      "verse_key": "37:83",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178325,
          "resource_id": 33,
          "text": "Dan sungguh, Ibrahim termasuk golongannya (Nuh).<sup foot_note=135680>1</sup>"
        }
      ]
    },
    {
      "id": 3872,
      "verse_number": 84,
      "verse_key": "37:84",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178326,
          "resource_id": 33,
          "text": "(Ingatlah) ketika dia datang kepada Tuhannya dengan hati yang suci,<sup foot_note=135681>1</sup>"
        }
      ]
    },
    {
      "id": 3873,
      "verse_number": 85,
      "verse_key": "37:85",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178327,
          "resource_id": 33,
          "text": "(ingatlah) ketika dia berkata kepada ayahnya dan kaumnya, \"Apakah yang kamu sembah itu?"
        }
      ]
    },
    {
      "id": 3874,
      "verse_number": 86,
      "verse_key": "37:86",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178328,
          "resource_id": 33,
          "text": "Apakah kamu menghendaki kebohongan dengan sesembahan selain Allah itu?"
        }
      ]
    },
    {
      "id": 3875,
      "verse_number": 87,
      "verse_key": "37:87",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178329,
          "resource_id": 33,
          "text": "Maka bagaimana anggapanmu terhadap Tuhan seluruh alam?\""
        }
      ]
    },
    {
      "id": 3876,
      "verse_number": 88,
      "verse_key": "37:88",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178330,
          "resource_id": 33,
          "text": "Lalu dia memandang sekilas ke bintang-bintang,"
        }
      ]
    },
    {
      "id": 3877,
      "verse_number": 89,
      "verse_key": "37:89",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ إِنِّى سَقِيمٌ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178331,
          "resource_id": 33,
          "text": "kemudian dia (Ibrahim) berkata, \"Sesungguhnya aku sakit.\""
        }
      ]
    },
    {
      "id": 3878,
      "verse_number": 90,
      "verse_key": "37:90",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178335,
          "resource_id": 33,
          "text": "Lalu mereka berpaling dari dia dan pergi meninggalkannya."
        }
      ]
    },
    {
      "id": 3879,
      "verse_number": 91,
      "verse_key": "37:91",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178334,
          "resource_id": 33,
          "text": "Kemudian dia (Ibrahim) pergi dengan diam-diam kepada berhala-berhala mereka; lalu dia berkata, \"Mengapa kamu tidak makan?<sup foot_note=135682>1</sup>"
        }
      ]
    },
    {
      "id": 3880,
      "verse_number": 92,
      "verse_key": "37:92",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "مَا لَكُمْ لَا تَنطِقُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 177494,
          "resource_id": 33,
          "text": "Mengapa kamu tidak menjawab?\""
        }
      ]
    },
    {
      "id": 3881,
      "verse_number": 93,
      "verse_key": "37:93",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178340,
          "resource_id": 33,
          "text": "Lalu dihadapinya (berhala-berhala) itu sambil memukulnya dengan tangan kanannya."
        }
      ]
    },
    {
      "id": 3882,
      "verse_number": 94,
      "verse_key": "37:94",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178336,
          "resource_id": 33,
          "text": "Kemudian mereka (kaumnya) datang bergegas kepadanya."
        }
      ]
    },
    {
      "id": 3883,
      "verse_number": 95,
      "verse_key": "37:95",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178337,
          "resource_id": 33,
          "text": "Dia (Ibrahim) berkata, \"Apakah kamu menyembah patung-patung yang kamu pahat itu?"
        }
      ]
    },
    {
      "id": 3884,
      "verse_number": 96,
      "verse_key": "37:96",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178338,
          "resource_id": 33,
          "text": "padahal Allah lah yang menciptakan kamu dan apa yang kamu perbuat.\""
        }
      ]
    },
    {
      "id": 3885,
      "verse_number": 97,
      "verse_key": "37:97",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178339,
          "resource_id": 33,
          "text": "Mereka berkata, \"Buatlah bangunan (perapian) untuknya (membakar Ibrahim); lalu lemparkan dia ke dalam api yang menyala-nyala itu.\""
        }
      ]
    },
    {
      "id": 3886,
      "verse_number": 98,
      "verse_key": "37:98",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178342,
          "resource_id": 33,
          "text": "Maka mereka bermaksud memperdayainya dengan (membakar)nya, (namun Allah menyelamatkannya), lalu Kami jadikan mereka orang-orang yang hina."
        }
      ]
    },
    {
      "id": 3887,
      "verse_number": 99,
      "verse_key": "37:99",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178341,
          "resource_id": 33,
          "text": "Dan dia (Ibrahim) berkata, \"Sesungguhnya aku harus pergi (menghadap) kepada Tuhanku, Dia akan memberi petunjuk kepadaku.<sup foot_note=135683>1</sup>"
        }
      ]
    },
    {
      "id": 3888,
      "verse_number": 100,
      "verse_key": "37:100",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178177,
          "resource_id": 33,
          "text": "Ya Tuhanku, anugerahkanlah kepadaku (seorang anak) yang saleh.\""
        }
      ]
    },
    {
      "id": 3889,
      "verse_number": 101,
      "verse_key": "37:101",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178179,
          "resource_id": 33,
          "text": "Maka Kami beri kabar gembira kepadanya dengan (kelahiran) seorang anak yang sangat sabar (Ismail)."
        }
      ]
    },
    {
      "id": 3890,
      "verse_number": 102,
      "verse_key": "37:102",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 390,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ",
      "chapter_id": 37,
      "page_number": 449,
      "juz_number": 23,
      "translations": [
        {
          "id": 178178,
          "resource_id": 33,
          "text": "Maka ketika anak itu sampai (pada umur) sanggup berusaha bersamanya, (Ibrahim) berkata, \"Wahai anakku! Sesungguhnya aku bermimpi bahwa aku menyembelihmu. Maka bagaimanakah pendapatmu!\" Dia (Ismail) menjawab, \"Wahai ayahku! Lakukanlah apa yang diperintahkan (Allah) kepadamu; insyā Allah engkau akan mendapatiku termasuk orang yang sabar.\""
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 26,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
