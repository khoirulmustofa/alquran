{
  "verses": [
    {
      "id": 4415,
      "verse_number": 1,
      "verse_key": "44:1",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": " حمٓ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 177512,
          "resource_id": 33,
          "text": "Ḥā Mīm."
        }
      ]
    },
    {
      "id": 4416,
      "verse_number": 2,
      "verse_key": "44:2",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْكِتَـٰبِ ٱلْمُبِينِ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 177549,
          "resource_id": 33,
          "text": "Demi Kitab (Alquran) yang jelas,"
        }
      ]
    },
    {
      "id": 4417,
      "verse_number": 3,
      "verse_key": "44:3",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةٍ مُّبَـٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178939,
          "resource_id": 33,
          "text": "Sesungguhnya Kami menurunkannya pada malam yang diberkahi.<sup foot_note=135742>1</sup> Sungguh, Kamilah yang memberi peringatan."
        }
      ]
    },
    {
      "id": 4418,
      "verse_number": 4,
      "verse_key": "44:4",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178952,
          "resource_id": 33,
          "text": "Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,<sup foot_note=135743>1</sup>"
        }
      ]
    },
    {
      "id": 4419,
      "verse_number": 5,
      "verse_key": "44:5",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَمْرًا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178968,
          "resource_id": 33,
          "text": "(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,"
        }
      ]
    },
    {
      "id": 4420,
      "verse_number": 6,
      "verse_key": "44:6",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَحْمَةً مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178974,
          "resource_id": 33,
          "text": "sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui,"
        }
      ]
    },
    {
      "id": 4421,
      "verse_number": 7,
      "verse_key": "44:7",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178975,
          "resource_id": 33,
          "text": "Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini."
        }
      ]
    },
    {
      "id": 4422,
      "verse_number": 8,
      "verse_key": "44:8",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَآ إِلَـٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178979,
          "resource_id": 33,
          "text": "Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu."
        }
      ]
    },
    {
      "id": 4423,
      "verse_number": 9,
      "verse_key": "44:9",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "بَلْ هُمْ فِى شَكٍّ يَلْعَبُونَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178981,
          "resource_id": 33,
          "text": "Tetapi mereka dalam keraguan, mereka bermain-main."
        }
      ]
    },
    {
      "id": 4424,
      "verse_number": 10,
      "verse_key": "44:10",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍ مُّبِينٍ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178989,
          "resource_id": 33,
          "text": "Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,<sup foot_note=135744>1</sup>"
        }
      ]
    },
    {
      "id": 4425,
      "verse_number": 11,
      "verse_key": "44:11",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ أَلِيمٌ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178917,
          "resource_id": 33,
          "text": "yang meliputi manusia. Inilah azab yang pedih."
        }
      ]
    },
    {
      "id": 4426,
      "verse_number": 12,
      "verse_key": "44:12",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178919,
          "resource_id": 33,
          "text": "(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\""
        }
      ]
    },
    {
      "id": 4427,
      "verse_number": 13,
      "verse_key": "44:13",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178918,
          "resource_id": 33,
          "text": "Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,"
        }
      ]
    },
    {
      "id": 4428,
      "verse_number": 14,
      "verse_key": "44:14",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178920,
          "resource_id": 33,
          "text": "kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\"<sup foot_note=135745>1</sup>"
        }
      ]
    },
    {
      "id": 4429,
      "verse_number": 15,
      "verse_key": "44:15",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178921,
          "resource_id": 33,
          "text": "Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar)."
        }
      ]
    },
    {
      "id": 4430,
      "verse_number": 16,
      "verse_key": "44:16",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178922,
          "resource_id": 33,
          "text": "(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras.<sup foot_note=135746>1</sup> Kami pasti memberi balasan."
        }
      ]
    },
    {
      "id": 4431,
      "verse_number": 17,
      "verse_key": "44:17",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌ كَرِيمٌ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178923,
          "resource_id": 33,
          "text": "Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun dan telah datang kepada mereka seorang Rasul yang mulia,"
        }
      ]
    },
    {
      "id": 4432,
      "verse_number": 18,
      "verse_key": "44:18",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
      "chapter_id": 44,
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 178924,
          "resource_id": 33,
          "text": "(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya,"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 18,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 18
  }
}