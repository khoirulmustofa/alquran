{
  "verses": [
    {
      "id": 5703,
      "verse_number": 31,
      "verse_key": "78:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180685,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang bertakwa mendapat kemenangan,"
        }
      ]
    },
    {
      "id": 5704,
      "verse_number": 32,
      "verse_key": "78:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "حَدَآئِقَ وَأَعْنَـٰبًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180691,
          "resource_id": 33,
          "text": "(yaitu) kebun-kebun dan buah anggur,"
        }
      ]
    },
    {
      "id": 5705,
      "verse_number": 33,
      "verse_key": "78:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَوَاعِبَ أَتْرَابًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180686,
          "resource_id": 33,
          "text": "dan gadis-gadis belia yang sebaya,"
        }
      ]
    },
    {
      "id": 5706,
      "verse_number": 34,
      "verse_key": "78:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَأْسًا دِهَاقًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180687,
          "resource_id": 33,
          "text": "dan gelas-gelas yang penuh (berisi minuman)."
        }
      ]
    },
    {
      "id": 5707,
      "verse_number": 35,
      "verse_key": "78:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180688,
          "resource_id": 33,
          "text": "Di sana mereka tidak mendengar percakapan yang sia-sia maupun (perkataan dusta)."
        }
      ]
    },
    {
      "id": 5708,
      "verse_number": 36,
      "verse_key": "78:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180689,
          "resource_id": 33,
          "text": "Sebagai balasan dan pemberian yang cukup banyak dari Tuhanmu,"
        }
      ]
    },
    {
      "id": 5709,
      "verse_number": 37,
      "verse_key": "78:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180690,
          "resource_id": 33,
          "text": "Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; Yang Maha Pengasih, mereka tidak mampu berbicara dengan Dia."
        }
      ]
    },
    {
      "id": 5710,
      "verse_number": 38,
      "verse_key": "78:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180692,
          "resource_id": 33,
          "text": "Pada hari, ketika rūḥ<sup foot_note=135845>1</sup> dan para malaikat berdiri bersaf-saf, mereka tidak berkata-kata, kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pengasih dan dia hanya mengatakan yang benar."
        }
      ]
    },
    {
      "id": 5711,
      "verse_number": 39,
      "verse_key": "78:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180693,
          "resource_id": 33,
          "text": "Itulah hari yang pasti terjadi. Maka barangsiapa menghendaki, niscaya dia menempuh jalan kembali kepada Tuhannya."
        }
      ]
    },
    {
      "id": 5712,
      "verse_number": 40,
      "verse_key": "78:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "chapter_id": 78,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180696,
          "resource_id": 33,
          "text": "Sesungguhnya Kami telah memperingatkan kepadamu (orang kafir) azab yang dekat, pada hari manusia melihat apa yang telah diperbuat oleh kedua tangannya; dan orang kafir berkata, \"Alangkah baiknya seandainya dahulu aku jadi tanah.\""
        }
      ]
    },
    {
      "id": 5713,
      "verse_number": 1,
      "verse_key": "79:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180752,
          "resource_id": 33,
          "text": "Demi (malaikat) yang mencabut (nyawa) dengan keras."
        }
      ]
    },
    {
      "id": 5714,
      "verse_number": 2,
      "verse_key": "79:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180732,
          "resource_id": 33,
          "text": "Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut."
        }
      ]
    },
    {
      "id": 5715,
      "verse_number": 3,
      "verse_key": "79:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180750,
          "resource_id": 33,
          "text": "Demi (malaikat) yang turun dari langit dengan cepat,"
        }
      ]
    },
    {
      "id": 5716,
      "verse_number": 4,
      "verse_key": "79:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180744,
          "resource_id": 33,
          "text": "dan (malaikat) yang mendahului dengan kencang,"
        }
      ]
    },
    {
      "id": 5717,
      "verse_number": 5,
      "verse_key": "79:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180754,
          "resource_id": 33,
          "text": "dan (malaikat) yang mengatur urusan (dunia).<sup foot_note=135846>1</sup>"
        }
      ]
    },
    {
      "id": 5718,
      "verse_number": 6,
      "verse_key": "79:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180803,
          "resource_id": 33,
          "text": "(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,"
        }
      ]
    },
    {
      "id": 5719,
      "verse_number": 7,
      "verse_key": "79:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180756,
          "resource_id": 33,
          "text": "(tiupan pertama) itu diiringi oleh tiupan kedua."
        }
      ]
    },
    {
      "id": 5720,
      "verse_number": 8,
      "verse_key": "79:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180758,
          "resource_id": 33,
          "text": "Hati manusia pada waktu itu merasa sangat takut,"
        }
      ]
    },
    {
      "id": 5721,
      "verse_number": 9,
      "verse_key": "79:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 182675,
          "resource_id": 33,
          "text": "pandangannya tunduk."
        }
      ]
    },
    {
      "id": 5722,
      "verse_number": 10,
      "verse_key": "79:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180603,
          "resource_id": 33,
          "text": "(orang-orang kafir) berkata, \"Apakah kita benar-benar akan dikembalikan kepada kehidupan yang semula?<sup foot_note=135847>1</sup>"
        }
      ]
    },
    {
      "id": 5723,
      "verse_number": 11,
      "verse_key": "79:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180711,
          "resource_id": 33,
          "text": "Apakah (akan dibangkitkan juga) apabila kita telah menjadi tulang belulang yang hancur?\""
        }
      ]
    },
    {
      "id": 5724,
      "verse_number": 12,
      "verse_key": "79:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180720,
          "resource_id": 33,
          "text": "Mereka berkata, \"Kalau demikian, itu adalah suatu pengembalian yang merugikan.\""
        }
      ]
    },
    {
      "id": 5725,
      "verse_number": 13,
      "verse_key": "79:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180712,
          "resource_id": 33,
          "text": "Maka pengembalian itu hanyalah dengan sekali tiupan saja."
        }
      ]
    },
    {
      "id": 5726,
      "verse_number": 14,
      "verse_key": "79:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180713,
          "resource_id": 33,
          "text": "Maka seketika itu mereka hidup kembali di bumi (yang baru)."
        }
      ]
    },
    {
      "id": 5727,
      "verse_number": 15,
      "verse_key": "79:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "chapter_id": 79,
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 180714,
          "resource_id": 33,
          "text": "Sudahkah sampai kepadamu (Muhammad) kisah Musa?"
        }
      ]
    }
  ],
