{
  "verses": [
    {
      "id": 1854,
      "verse_number": 52,
      "verse_key": "15:52",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا قَالَ إِنَّا مِنكُمْ وَجِلُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181928,
          "resource_id": 33,
          "text": "Ketika mereka masuk ke tempatnya, lalu mereka mengucapkan, \"Salām.\" Dia (Ibrahim) berkata, \"kami benar-benar merasa takut kepadamu.\""
        }
      ]
    },
    {
      "id": 1855,
      "verse_number": 53,
      "verse_key": "15:53",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ عَلِيمٍ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181842,
          "resource_id": 33,
          "text": "(Mereka) berkata, \"Janganlah engkau merasa takut, sesungguhnya kami memberi kabar gembira kepadamu dengan (kelahiran seorang) anak laki-laki (yang akan menjadi) orang yang pandai (Ishak).\""
        }
      ]
    },
    {
      "id": 1856,
      "verse_number": 54,
      "verse_key": "15:54",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالَ أَبَشَّرْتُمُونِى عَلَىٰٓ أَن مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182874,
          "resource_id": 33,
          "text": "Dia (Ibrahim) berkata, \"Benarkah kamu memberi kabar gembira kepadaku padahal usiaku telah lanjut, lalu (dengan cara) bagaimana kamu memberi (kabar gembira) tersebut?\""
        }
      ]
    },
    {
      "id": 1857,
      "verse_number": 55,
      "verse_key": "15:55",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ بَشَّرْنَـٰكَ بِٱلْحَقِّ فَلَا تَكُن مِّنَ ٱلْقَـٰنِطِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182875,
          "resource_id": 33,
          "text": "(Mereka) menjawab, \"Kami menyampaikan kabar gembira kepadamu dengan benar, maka janganlah engkau termasuk orang yang berputus asa!\""
        }
      ]
    },
    {
      "id": 1858,
      "verse_number": 56,
      "verse_key": "15:56",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181845,
          "resource_id": 33,
          "text": "Dia (Ibrahim) berkata, \"Tidak ada yang berputus asa dari rahmat Tuhannya, kecuali orang yang sesat.\""
        }
      ]
    },
    {
      "id": 1859,
      "verse_number": 57,
      "verse_key": "15:57",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181841,
          "resource_id": 33,
          "text": "Dia (Ibrahim) berkata, \"Apakah perkara pentingmu, wahai para utusan?\""
        }
      ]
    },
    {
      "id": 1860,
      "verse_number": 58,
      "verse_key": "15:58",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ مُّجْرِمِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181934,
          "resource_id": 33,
          "text": "(Mereka) menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa,"
        }
      ]
    },
    {
      "id": 1861,
      "verse_number": 59,
      "verse_key": "15:59",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182867,
          "resource_id": 33,
          "text": "kecuali para pengikut Luṭ. Sesungguhnya kami pasti menyelamatkan mereka semuanya,"
        }
      ]
    },
    {
      "id": 1862,
      "verse_number": 60,
      "verse_key": "15:60",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 221,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ ٱلْغَـٰبِرِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181849,
          "resource_id": 33,
          "text": "kecuali istrinya, kami telah menentukan, bahwa dia termasuk orang yang tertinggal (bersama orang kafir lainnya).\""
        }
      ]
    },
    {
      "id": 1863,
      "verse_number": 61,
      "verse_key": "15:61",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181904,
          "resource_id": 33,
          "text": "Maka ketika utusan itu datang kepada para pengikut Luṭ,"
        }
      ]
    },
    {
      "id": 1864,
      "verse_number": 62,
      "verse_key": "15:62",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالَ إِنَّكُمْ قَوْمٌ مُّنكَرُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182742,
          "resource_id": 33,
          "text": "dia (Luṭ) berkata, \"Sesungguhnya kamu orang yang tidak kami kenal.\""
        }
      ]
    },
    {
      "id": 1865,
      "verse_number": 63,
      "verse_key": "15:63",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ بَلْ جِئْنَـٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182864,
          "resource_id": 33,
          "text": "(Para utusan) menjawab, \"Sebenarnya kami ini datang kepadamu membawa azab yang selalu mereka dustakan."
        }
      ]
    },
    {
      "id": 1866,
      "verse_number": 64,
      "verse_key": "15:64",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "وَأَتَيْنَـٰكَ بِٱلْحَقِّ وَإِنَّا لَصَـٰدِقُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181848,
          "resource_id": 33,
          "text": "Dan kami datang kepadamu membawa kebenaran dan sungguh, kami orang yang benar."
        }
      ]
    },
    {
      "id": 1867,
      "verse_number": 65,
      "verse_key": "15:65",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182866,
          "resource_id": 33,
          "text": "Maka pergilah kamu pada akhir malam beserta keluargamu, dan ikutilah mereka dari belakang! Jangan ada di antara kamu yang menoleh ke belakang dan teruskanlah perjalanan ke tempat yang diperintahkan kepadamu.\""
        }
      ]
    },
    {
      "id": 1868,
      "verse_number": 66,
      "verse_key": "15:66",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌ مُّصْبِحِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181851,
          "resource_id": 33,
          "text": "Dan telah Kami tetapkan kepadanya (Luṭ) keputusan itu, bahwa akhirnya mereka akan ditumpas habis pada waktu subuh."
        }
      ]
    },
    {
      "id": 1869,
      "verse_number": 67,
      "verse_key": "15:67",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181898,
          "resource_id": 33,
          "text": "Dan datanglah penduduk kota itu<sup foot_note=135388>1</sup> (ke rumah Luṭ) dengan gembira (karena kedatangan tamu itu)."
        }
      ]
    },
    {
      "id": 1870,
      "verse_number": 68,
      "verse_key": "15:68",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181840,
          "resource_id": 33,
          "text": "Dia (Luṭ) berkata, \"Sesungguhnya mereka adalah tamuku; maka jangan kamu mempermalukan aku,"
        }
      ]
    },
    {
      "id": 1871,
      "verse_number": 69,
      "verse_key": "15:69",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 181828,
          "resource_id": 33,
          "text": "dan bertakwalah kepada Allah dan janganlah kamu membuat aku terhina!\""
        }
      ]
    },
    {
      "id": 1872,
      "verse_number": 70,
      "verse_key": "15:70",
      "hizb_number": 27,
      "rub_el_hizb_number": 106,
      "ruku_number": 222,
      "manzil_number": 3,
      "sajdah_number": null,
      "text_uthmani": "قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَـٰلَمِينَ",
      "chapter_id": 15,
      "page_number": 265,
      "juz_number": 14,
      "translations": [
        {
          "id": 182865,
          "resource_id": 33,
          "text": "(Mereka) berkata, \"Bukankah kami telah melarangmu dari (melindungi) manusia?\"<sup foot_note=135389>1</sup>"
        }
      ]
    }
  ],
