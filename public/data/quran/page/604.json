{
  "verses": [
    {
      "id": 6222,
      "verse_number": 1,
      "verse_key": "112:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 556,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " قُلْ هُوَ ٱللَّهُ أَحَدٌ",
      "chapter_id": 112,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181508,
          "resource_id": 33,
          "text": "Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa."
        }
      ]
    },
    {
      "id": 6223,
      "verse_number": 2,
      "verse_key": "112:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 556,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱللَّهُ ٱلصَّمَدُ",
      "chapter_id": 112,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181489,
          "resource_id": 33,
          "text": "Allah tempat meminta segala sesuatu."
        }
      ]
    },
    {
      "id": 6224,
      "verse_number": 3,
      "verse_key": "112:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 556,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "chapter_id": 112,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181501,
          "resource_id": 33,
          "text": "(Allah) tidak beranak dan tidak pula diperanakkan."
        }
      ]
    },
    {
      "id": 6225,
      "verse_number": 4,
      "verse_key": "112:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 556,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
      "chapter_id": 112,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181490,
          "resource_id": 33,
          "text": "Dan tidak ada sesuatu yang setara dengan Dia.\""
        }
      ]
    },
    {
      "id": 6226,
      "verse_number": 1,
      "verse_key": "113:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 557,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "chapter_id": 113,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181509,
          "resource_id": 33,
          "text": "Katakanlah, \"Aku berlindung kepada Tuhan yang menguasai subuh (fajar),"
        }
      ]
    },
    {
      "id": 6227,
      "verse_number": 2,
      "verse_key": "113:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 557,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِن شَرِّ مَا خَلَقَ",
      "chapter_id": 113,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 177232,
          "resource_id": 33,
          "text": "dari kejahatan (makhluk yang) Dia ciptakan,"
        }
      ]
    },
    {
      "id": 6228,
      "verse_number": 3,
      "verse_key": "113:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 557,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "chapter_id": 113,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181513,
          "resource_id": 33,
          "text": "dan dari kejahatan malam apabila telah gelap gulita,"
        }
      ]
    },
    {
      "id": 6229,
      "verse_number": 4,
      "verse_key": "113:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 557,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
      "chapter_id": 113,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181404,
          "resource_id": 33,
          "text": "dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya),"
        }
      ]
    },
    {
      "id": 6230,
      "verse_number": 5,
      "verse_key": "113:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 557,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "chapter_id": 113,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181504,
          "resource_id": 33,
          "text": "dan dari kejahatan orang yang dengki apabila dia dengki.\""
        }
      ]
    },
    {
      "id": 6231,
      "verse_number": 1,
      "verse_key": "114:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181523,
          "resource_id": 33,
          "text": "Katakanlah, \"Aku berlindung kepada Tuhannya manusia,"
        }
      ]
    },
    {
      "id": 6232,
      "verse_number": 2,
      "verse_key": "114:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَلِكِ ٱلنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181522,
          "resource_id": 33,
          "text": "Raja manusia,"
        }
      ]
    },
    {
      "id": 6233,
      "verse_number": 3,
      "verse_key": "114:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَـٰهِ ٱلنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181528,
          "resource_id": 33,
          "text": "sembahan manusia,"
        }
      ]
    },
    {
      "id": 6234,
      "verse_number": 4,
      "verse_key": "114:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181531,
          "resource_id": 33,
          "text": "dari kejahatan (bisikan) setan yang bersembunyi,"
        }
      ]
    },
    {
      "id": 6235,
      "verse_number": 5,
      "verse_key": "114:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181521,
          "resource_id": 33,
          "text": "yang membisikkan (kejahatan) ke dalam dada manusia,"
        }
      ]
    },
    {
      "id": 6236,
      "verse_number": 6,
      "verse_key": "114:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 558,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
      "chapter_id": 114,
      "page_number": 604,
      "juz_number": 30,
      "translations": [
        {
          "id": 181535,
          "resource_id": 33,
          "text": "dari (golongan) jin dan manusia.\""
        }
      ]
    }
  ],
