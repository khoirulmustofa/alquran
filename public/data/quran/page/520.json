{
  "verses": [
    {
      "id": 4666,
      "verse_number": 36,
      "verse_key": "50:36",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمْ أَشَدُّ مِنْهُم بَطْشًا فَنَقَّبُوا۟ فِى ٱلْبِلَـٰدِ هَلْ مِن مَّحِيصٍ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179219,
          "resource_id": 33,
          "text": "Dan betapa banyak umat yang telah Kami binasakan sebelum mereka, (padahal) mereka lebih hebat kekuatannya daripada mereka (umat yang belakangan) ini. Mereka pernah menjelajah di beberapa negeri. Adakah tempat pelarian (dari kebinasaan bagi mereka)?"
        }
      ]
    },
    {
      "id": 4667,
      "verse_number": 37,
      "verse_key": "50:37",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ فِى ذَٰلِكَ لَذِكْرَىٰ لِمَن كَانَ لَهُۥ قَلْبٌ أَوْ أَلْقَى ٱلسَّمْعَ وَهُوَ شَهِيدٌ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179221,
          "resource_id": 33,
          "text": "Sungguh, pada yang demikian itu pasti terdapat peringatan bagi orang-orang yang mempunyai hati atau yang menggunakan pendengarannya, sedang dia menyaksikannya."
        }
      ]
    },
    {
      "id": 4668,
      "verse_number": 38,
      "verse_key": "50:38",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ وَمَا مَسَّنَا مِن لُّغُوبٍ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179222,
          "resource_id": 33,
          "text": "Dan sungguh, Kami telah menciptakan langit dan bumi dan apa yang ada di antara keduanya dalam enam masa, dan Kami tidak merasa letih sedikit pun."
        }
      ]
    },
    {
      "id": 4669,
      "verse_number": 39,
      "verse_key": "50:39",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ ٱلْغُرُوبِ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179223,
          "resource_id": 33,
          "text": "Maka bersabarlah engkau (Muhammad) terhadap apa yang mereka katakan, dan bertasbihlah dengan memuji Tuhanmu sebelum matahari terbit dan sebelum terbenam."
        }
      ]
    },
    {
      "id": 4670,
      "verse_number": 40,
      "verse_key": "50:40",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَأَدْبَـٰرَ ٱلسُّجُودِ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179225,
          "resource_id": 33,
          "text": "Dan bertasbihlah kepada-Nya pada malam hari dan setiap selesai salat."
        }
      ]
    },
    {
      "id": 4671,
      "verse_number": 41,
      "verse_key": "50:41",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍ قَرِيبٍ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179228,
          "resource_id": 33,
          "text": "Dan dengarkanlah (seruan) pada hari (ketika) penyeru (malaikat) menyeru dari tempat yang dekat."
        }
      ]
    },
    {
      "id": 4672,
      "verse_number": 42,
      "verse_key": "50:42",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179226,
          "resource_id": 33,
          "text": "(Yaitu) pada hari (ketika) mereka mendengar suara dahsyat dengan sebenarnya. Itulah hari keluar (dari kubur)."
        }
      ]
    },
    {
      "id": 4673,
      "verse_number": 43,
      "verse_key": "50:43",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا نَحْنُ نُحْىِۦ وَنُمِيتُ وَإِلَيْنَا ٱلْمَصِيرُ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179227,
          "resource_id": 33,
          "text": "Sungguh, Kami yang menghidupkan dan mematikan, dan kepada Kami tempat kembali (semua makhluk)."
        }
      ]
    },
    {
      "id": 4674,
      "verse_number": 44,
      "verse_key": "50:44",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تَشَقَّقُ ٱلْأَرْضُ عَنْهُمْ سِرَاعًا ۚ ذَٰلِكَ حَشْرٌ عَلَيْنَا يَسِيرٌ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179229,
          "resource_id": 33,
          "text": "(Yaitu) pada hari (ketika) bumi terbelah, mereka keluar dengan cepat. Yang demikian itu adalah pengumpulan yang mudah bagi Kami."
        }
      ]
    },
    {
      "id": 4675,
      "verse_number": 45,
      "verse_key": "50:45",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 456,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ ۖ وَمَآ أَنتَ عَلَيْهِم بِجَبَّارٍ ۖ فَذَكِّرْ بِٱلْقُرْءَانِ مَن يَخَافُ وَعِيدِ",
      "chapter_id": 50,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179230,
          "resource_id": 33,
          "text": "Kami lebih mengetahui tentang apa yang mereka katakan, dan engkau (Muhammad) bukanlah seorang pemaksa terhadap mereka. Maka berilah peringatan dengan Alquran kepada siapa pun yang takut kepada ancaman-Ku."
        }
      ]
    },
    {
      "id": 4676,
      "verse_number": 1,
      "verse_key": "51:1",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلذَّٰرِيَـٰتِ ذَرْوًا",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 177407,
          "resource_id": 33,
          "text": "Demi (angin) yang menerbangkan debu,"
        }
      ]
    },
    {
      "id": 4677,
      "verse_number": 2,
      "verse_key": "51:2",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْحَـٰمِلَـٰتِ وِقْرًا",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 181858,
          "resource_id": 33,
          "text": "dan awan yang mengandung (hujan),"
        }
      ]
    },
    {
      "id": 4678,
      "verse_number": 3,
      "verse_key": "51:3",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْجَـٰرِيَـٰتِ يُسْرًا",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179294,
          "resource_id": 33,
          "text": "dan (kapal-kapal) yang berlayar dengan mudah,"
        }
      ]
    },
    {
      "id": 4679,
      "verse_number": 4,
      "verse_key": "51:4",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُقَسِّمَـٰتِ أَمْرًا",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179316,
          "resource_id": 33,
          "text": "dan (malaikat-malaikat) yang membagi-bagi urusan,"
        }
      ]
    },
    {
      "id": 4680,
      "verse_number": 5,
      "verse_key": "51:5",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّمَا تُوعَدُونَ لَصَادِقٌ",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179305,
          "resource_id": 33,
          "text": "sungguh, apa yang dijanjikan kepadamu pasti benar,"
        }
      ]
    },
    {
      "id": 4681,
      "verse_number": 6,
      "verse_key": "51:6",
      "hizb_number": 52,
      "rub_el_hizb_number": 208,
      "ruku_number": 457,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌ",
      "chapter_id": 51,
      "page_number": 520,
      "juz_number": 26,
      "translations": [
        {
          "id": 179325,
          "resource_id": 33,
          "text": "dan sungguh, (hari) pembalasan pasti terjadi."
        }
      ]
    }
  ],
