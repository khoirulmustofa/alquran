{
  "verses": [
    {
      "id": 5728,
      "verse_number": 16,
      "verse_key": "79:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180715,
          "resource_id": 33,
          "text": "Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;"
        }
      ]
    },
    {
      "id": 5729,
      "verse_number": 17,
      "verse_key": "79:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180716,
          "resource_id": 33,
          "text": "pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,"
        }
      ]
    },
    {
      "id": 5730,
      "verse_number": 18,
      "verse_key": "79:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180717,
          "resource_id": 33,
          "text": "Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),"
        }
      ]
    },
    {
      "id": 5731,
      "verse_number": 19,
      "verse_key": "79:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180718,
          "resource_id": 33,
          "text": "dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\""
        }
      ]
    },
    {
      "id": 5732,
      "verse_number": 20,
      "verse_key": "79:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180721,
          "resource_id": 33,
          "text": "Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar."
        }
      ]
    },
    {
      "id": 5733,
      "verse_number": 21,
      "verse_key": "79:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبَ وَعَصَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180722,
          "resource_id": 33,
          "text": "Tetapi dia (Fir'aun) mendustakan dan mendurhakai."
        }
      ]
    },
    {
      "id": 5734,
      "verse_number": 22,
      "verse_key": "79:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180723,
          "resource_id": 33,
          "text": "Kemudian dia berpaling seraya berusaha menantang (Musa)."
        }
      ]
    },
    {
      "id": 5735,
      "verse_number": 23,
      "verse_key": "79:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَحَشَرَ فَنَادَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180724,
          "resource_id": 33,
          "text": "Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya)."
        }
      ]
    },
    {
      "id": 5736,
      "verse_number": 24,
      "verse_key": "79:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180725,
          "resource_id": 33,
          "text": "(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\""
        }
      ]
    },
    {
      "id": 5737,
      "verse_number": 25,
      "verse_key": "79:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180726,
          "resource_id": 33,
          "text": "Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia."
        }
      ]
    },
    {
      "id": 5738,
      "verse_number": 26,
      "verse_key": "79:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180727,
          "resource_id": 33,
          "text": "Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah)."
        }
      ]
    },
    {
      "id": 5739,
      "verse_number": 27,
      "verse_key": "79:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180728,
          "resource_id": 33,
          "text": "Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?"
        }
      ]
    },
    {
      "id": 5740,
      "verse_number": 28,
      "verse_key": "79:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180729,
          "resource_id": 33,
          "text": "Dia telah meninggikan bangunannya lalu menyempurnakannya,"
        }
      ]
    },
    {
      "id": 5741,
      "verse_number": 29,
      "verse_key": "79:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180730,
          "resource_id": 33,
          "text": "dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang)."
        }
      ]
    },
    {
      "id": 5742,
      "verse_number": 30,
      "verse_key": "79:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 177551,
          "resource_id": 33,
          "text": "Dan setelah itu bumi Dia hamparkan."
        }
      ]
    },
    {
      "id": 5743,
      "verse_number": 31,
      "verse_key": "79:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180733,
          "resource_id": 33,
          "text": "Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya."
        }
      ]
    },
    {
      "id": 5744,
      "verse_number": 32,
      "verse_key": "79:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180734,
          "resource_id": 33,
          "text": "Dan gunung-gunung Dia pancangkan dengan kokoh."
        }
      ]
    },
    {
      "id": 5745,
      "verse_number": 33,
      "verse_key": "79:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180735,
          "resource_id": 33,
          "text": "(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu."
        }
      ]
    },
    {
      "id": 5746,
      "verse_number": 34,
      "verse_key": "79:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180736,
          "resource_id": 33,
          "text": "Maka apabila malapetaka besar (hari Kiamat) telah datang,"
        }
      ]
    },
    {
      "id": 5747,
      "verse_number": 35,
      "verse_key": "79:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180737,
          "resource_id": 33,
          "text": "yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,"
        }
      ]
    },
    {
      "id": 5748,
      "verse_number": 36,
      "verse_key": "79:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180738,
          "resource_id": 33,
          "text": "dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat."
        }
      ]
    },
    {
      "id": 5749,
      "verse_number": 37,
      "verse_key": "79:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَن طَغَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180742,
          "resource_id": 33,
          "text": "Maka adapun orang yang melampaui batas,"
        }
      ]
    },
    {
      "id": 5750,
      "verse_number": 38,
      "verse_key": "79:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180739,
          "resource_id": 33,
          "text": "dan lebih mengutamakan kehidupan dunia,"
        }
      ]
    },
    {
      "id": 5751,
      "verse_number": 39,
      "verse_key": "79:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180740,
          "resource_id": 33,
          "text": "maka sungguh, nerakalah tempat tinggalnya."
        }
      ]
    },
    {
      "id": 5752,
      "verse_number": 40,
      "verse_key": "79:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180743,
          "resource_id": 33,
          "text": "Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,"
        }
      ]
    },
    {
      "id": 5753,
      "verse_number": 41,
      "verse_key": "79:41",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 178289,
          "resource_id": 33,
          "text": "maka sungguh, surgalah tempat tinggal-(nya)."
        }
      ]
    },
    {
      "id": 5754,
      "verse_number": 42,
      "verse_key": "79:42",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180745,
          "resource_id": 33,
          "text": "Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\""
        }
      ]
    },
    {
      "id": 5755,
      "verse_number": 43,
      "verse_key": "79:43",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180746,
          "resource_id": 33,
          "text": "Untuk apa engkau perlu menyebutkannya (waktunya)?"
        }
      ]
    },
    {
      "id": 5756,
      "verse_number": 44,
      "verse_key": "79:44",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180747,
          "resource_id": 33,
          "text": "Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya)."
        }
      ]
    },
    {
      "id": 5757,
      "verse_number": 45,
      "verse_key": "79:45",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 180748,
          "resource_id": 33,
          "text": "Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat)."
        }
      ]
    },
    {
      "id": 5758,
      "verse_number": 46,
      "verse_key": "79:46",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
      "chapter_id": 79,
      "page_number": 584,
