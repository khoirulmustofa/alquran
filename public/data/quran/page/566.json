{
  "verses": [
    {
      "id": 5314,
      "verse_number": 43,
      "verse_key": "68:43",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَـٰلِمُونَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180107,
          "resource_id": 33,
          "text": "pandangan mereka tertunduk ke bawah, diliputi kehinaan. Dan sungguh, dahulu (di dunia) mereka telah diseru untuk bersujud waktu mereka sehat (tetapi mereka tidak melakukan)."
        }
      ]
    },
    {
      "id": 5315,
      "verse_number": 44,
      "verse_key": "68:44",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180108,
          "resource_id": 33,
          "text": "Maka serahkanlah kepada-Ku (urusannya) dan orang-orang yang mendustakan perkataan ini (Alquran). Kelak akan Kami hukum mereka berangsur-angsur dari arah yang tidak mereka ketahui,"
        }
      ]
    },
    {
      "id": 5316,
      "verse_number": 45,
      "verse_key": "68:45",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180109,
          "resource_id": 33,
          "text": "dan Aku memberi tenggang waktu kepada mereka. Sungguh, rencana-Ku sangat teguh."
        }
      ]
    },
    {
      "id": 5317,
      "verse_number": 46,
      "verse_key": "68:46",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180111,
          "resource_id": 33,
          "text": "Ataukah engkau (Muhammad) meminta imbalan kepada mereka, sehingga mereka dibebani dengan hutang?"
        }
      ]
    },
    {
      "id": 5318,
      "verse_number": 47,
      "verse_key": "68:47",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180110,
          "resource_id": 33,
          "text": "Ataukah mereka mengetahui yang gaib, lalu mereka menuliskannya?"
        }
      ]
    },
    {
      "id": 5319,
      "verse_number": 48,
      "verse_key": "68:48",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180112,
          "resource_id": 33,
          "text": "Maka bersabarlah engkau (Muhammad) terhadap ketetapan Tuhanmu, dan janganlah engkau seperti (Yunus) orang yang berada dalam (perut) ikan ketika dia berdoa dengan hati sedih."
        }
      ]
    },
    {
      "id": 5320,
      "verse_number": 49,
      "verse_key": "68:49",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180113,
          "resource_id": 33,
          "text": "Sekiranya dia tidak segera mendapat nikmat dari Tuhannya, pastilah dia dicampakkan ke tanah tandus dalam keadaan tercela."
        }
      ]
    },
    {
      "id": 5321,
      "verse_number": 50,
      "verse_key": "68:50",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱجْتَبَـٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 179736,
          "resource_id": 33,
          "text": "Lalu Tuhannya memilihnya dan menjadikannya termasuk orang yang saleh."
        }
      ]
    },
    {
      "id": 5322,
      "verse_number": 51,
      "verse_key": "68:51",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180114,
          "resource_id": 33,
          "text": "Dan sungguh, orang-orang kafir itu hampir-hampir menggelincirkanmu dengan pandangan mata mereka, ketika mereka mendengar Alquran dan mereka berkata, \"Dia (Muhammad) itu benar-benar orang gila.\"<sup foot_note=135804>1</sup>"
        }
      ]
    },
    {
      "id": 5323,
      "verse_number": 52,
      "verse_key": "68:52",
      "hizb_number": 57,
      "rub_el_hizb_number": 226,
      "ruku_number": 501,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "chapter_id": 68,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180119,
          "resource_id": 33,
          "text": "Padahal Alquran itu tidak lain adalah peringatan bagi seluruh alam."
        }
      ]
    },
    {
      "id": 5324,
      "verse_number": 1,
      "verse_key": "69:1",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱلْحَآقَّةُ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 182161,
          "resource_id": 33,
          "text": "Hari kiamat,<sup foot_note=135805>1</sup>"
        }
      ]
    },
    {
      "id": 5325,
      "verse_number": 2,
      "verse_key": "69:2",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَا ٱلْحَآقَّةُ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180292,
          "resource_id": 33,
          "text": "apakah hari Kiamat itu?"
        }
      ]
    },
    {
      "id": 5326,
      "verse_number": 3,
      "verse_key": "69:3",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180161,
          "resource_id": 33,
          "text": "Dan tahukah kamu apakah hari Kiamat itu?"
        }
      ]
    },
    {
      "id": 5327,
      "verse_number": 4,
      "verse_key": "69:4",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180170,
          "resource_id": 33,
          "text": "Kaum Samud, dan 'Ād telah mendustakan hari Kiamat.<sup foot_note=135806>1</sup>"
        }
      ]
    },
    {
      "id": 5328,
      "verse_number": 5,
      "verse_key": "69:5",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180178,
          "resource_id": 33,
          "text": "Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,<sup foot_note=135807>1</sup>"
        }
      ]
    },
    {
      "id": 5329,
      "verse_number": 6,
      "verse_key": "69:6",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180180,
          "resource_id": 33,
          "text": "sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,"
        }
      ]
    },
    {
      "id": 5330,
      "verse_number": 7,
      "verse_key": "69:7",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180181,
          "resource_id": 33,
          "text": "Allah menimpakan angin itu kepada mereka selama tujuh malam delapan hari terus-menerus; maka kamu melihat kaum 'Ād pada waktu itu mati bergelimpangan seperti batang-batang pohon kurma yang telah kosong (lapuk)."
        }
      ]
    },
    {
      "id": 5331,
      "verse_number": 8,
      "verse_key": "69:8",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
      "chapter_id": 69,
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 180183,
          "resource_id": 33,
          "text": "Maka adakah kamu melihat seorang pun yang masih tersisa di antara mereka? <sup foot_note=135808>1</sup>"
        }
      ]
    }
  ],
