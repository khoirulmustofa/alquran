{
  "verses": [
    {
      "id": 4811,
      "verse_number": 27,
      "verse_key": "53:27",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179397,
          "resource_id": 33,
          "text": "Sesungguhnya orang-orang yang tidak beriman kepada kehidupan akhirat, sungguh mereka menamakan para malaikat dengan nama perempuan."
        }
      ]
    },
    {
      "id": 4812,
      "verse_number": 28,
      "verse_key": "53:28",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179398,
          "resource_id": 33,
          "text": "Dan mereka tidak mempunyai ilmu tentang itu. Mereka tidak lain hanyalah mengikuti dugaan, dan sesungguhnya dugaan itu tidak berfaedah sedikit pun terhadap kebenaran."
        }
      ]
    },
    {
      "id": 4813,
      "verse_number": 29,
      "verse_key": "53:29",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179399,
          "resource_id": 33,
          "text": "Maka tinggalkanlah (Muhammad) orang yang berpaling dari peringatan Kami, dan dia hanya mengingini kehidupan dunia."
        }
      ]
    },
    {
      "id": 4814,
      "verse_number": 30,
      "verse_key": "53:30",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 177419,
          "resource_id": 33,
          "text": "Itulah kadar ilmu mereka. Sungguh, Tuhanmu, Dia lebih mengetahui siapa yang tersesat dari jalan-Nya dan Dia pula yang lebih mengetahui siapa yang mendapat petunjuk."
        }
      ]
    },
    {
      "id": 4815,
      "verse_number": 31,
      "verse_key": "53:31",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179402,
          "resource_id": 33,
          "text": "Dan milik Allah lah apa yang ada di langit dan apa yang ada di bumi. (Dengan demikian) Dia akan memberi balasan kepada orang-orang yang berbuat jahat sesuai dengan apa yang telah mereka kerjakan dan Dia akan memberi balasan kepada orang-orang yang berbuat baik dengan pahala yang lebih baik (surga)."
        }
      ]
    },
    {
      "id": 4816,
      "verse_number": 32,
      "verse_key": "53:32",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 463,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179404,
          "resource_id": 33,
          "text": "(Yaitu) mereka yang menjauhi dosa-dosa besar dan perbuatan keji, kecuali kesalahan-kesalahan kecil. Sungguh, Tuhanmu Mahaluas ampunan-Nya. Dia mengetahui tentang kamu, sejak Dia menjadikan kamu dari tanah lalu ketika kamu masih janin dalam perut ibumu. Maka janganlah kamu menganggap dirimu suci. Dia mengetahui tentang orang yang bertakwa."
        }
      ]
    },
    {
      "id": 4817,
      "verse_number": 33,
      "verse_key": "53:33",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 181872,
          "resource_id": 33,
          "text": "Maka tidakkah engkau melihat orang yang berpaling (dari Alquran)?"
        }
      ]
    },
    {
      "id": 4818,
      "verse_number": 34,
      "verse_key": "53:34",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179457,
          "resource_id": 33,
          "text": "dan dia memberikan sedikit (dari apa yang dijanjikan) lalu menahan sisanya."
        }
      ]
    },
    {
      "id": 4819,
      "verse_number": 35,
      "verse_key": "53:35",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179411,
          "resource_id": 33,
          "text": "Apakah dia mempunyai ilmu tentang yang gaib sehingga dia dapat melihat(nya)?"
        }
      ]
    },
    {
      "id": 4820,
      "verse_number": 36,
      "verse_key": "53:36",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179406,
          "resource_id": 33,
          "text": "Ataukah belum diberitakan (kepadanya) apa yang ada dalam lembaran-lembaran (Kitab Suci yang diturunkan kepada) Musa?"
        }
      ]
    },
    {
      "id": 4821,
      "verse_number": 37,
      "verse_key": "53:37",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179407,
          "resource_id": 33,
          "text": "Dan (lembaran-lembaran) Ibrahim yang selalu menyempurnakan janji?"
        }
      ]
    },
    {
      "id": 4822,
      "verse_number": 38,
      "verse_key": "53:38",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179408,
          "resource_id": 33,
          "text": "(yaitu) bahwa seseorang yang berdosa tidak akan memikul dosa orang lain,"
        }
      ]
    },
    {
      "id": 4823,
      "verse_number": 39,
      "verse_key": "53:39",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179409,
          "resource_id": 33,
          "text": "dan bahwa manusia hanya memperoleh apa yang telah diusahakannya,"
        }
      ]
    },
    {
      "id": 4824,
      "verse_number": 40,
      "verse_key": "53:40",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179412,
          "resource_id": 33,
          "text": "dan sesungguhnya usahanya itu kelak akan diperlihatkan (kepadanya),"
        }
      ]
    },
    {
      "id": 4825,
      "verse_number": 41,
      "verse_key": "53:41",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179413,
          "resource_id": 33,
          "text": "kemudian akan diberi balasan kepadanya dengan balasan yang paling sempurna,"
        }
      ]
    },
    {
      "id": 4826,
      "verse_number": 42,
      "verse_key": "53:42",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179414,
          "resource_id": 33,
          "text": "dan sesungguhnya kepada Tuhanmulah kesudahannya (segala sesuatu),"
        }
      ]
    },
    {
      "id": 4827,
      "verse_number": 43,
      "verse_key": "53:43",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179415,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang menjadikan orang tertawa dan menangis,"
        }
      ]
    },
    {
      "id": 4828,
      "verse_number": 44,
      "verse_key": "53:44",
      "hizb_number": 53,
      "rub_el_hizb_number": 211,
      "ruku_number": 464,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "chapter_id": 53,
      "page_number": 527,
      "juz_number": 27,
      "translations": [
        {
          "id": 179416,
          "resource_id": 33,
          "text": "dan sesungguhnya Dialah yang mematikan dan menghidupkan,"
        }
      ]
    }
  ],
