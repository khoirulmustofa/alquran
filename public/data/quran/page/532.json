{
  "verses": [
    {
      "id": 4918,
      "verse_number": 17,
      "verse_key": "55:17",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179520,
          "resource_id": 33,
          "text": "Tuhan (yang memelihara) dua Timur dan Tuhan (yang memelihara) dua Barat.<sup foot_note=135770>1</sup>"
        }
      ]
    },
    {
      "id": 4919,
      "verse_number": 18,
      "verse_key": "55:18",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179521,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4920,
      "verse_number": 19,
      "verse_key": "55:19",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179522,
          "resource_id": 33,
          "text": "Dia membiarkan dua laut mengalir yang (kemudian) keduanya bertemu,"
        }
      ]
    },
    {
      "id": 4921,
      "verse_number": 20,
      "verse_key": "55:20",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179535,
          "resource_id": 33,
          "text": "di antara keduanya ada batas yang tidak dilampaui oleh masing-masing.<sup foot_note=135771>1</sup>"
        }
      ]
    },
    {
      "id": 4922,
      "verse_number": 21,
      "verse_key": "55:21",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179525,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4923,
      "verse_number": 22,
      "verse_key": "55:22",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179526,
          "resource_id": 33,
          "text": "Dari keduanya keluar mutiara dan marjan."
        }
      ]
    },
    {
      "id": 4924,
      "verse_number": 23,
      "verse_key": "55:23",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179527,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4925,
      "verse_number": 24,
      "verse_key": "55:24",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179528,
          "resource_id": 33,
          "text": "Milik-Nyalah kapal-kapal yang berlayar di lautan bagaikan gunung-gunung."
        }
      ]
    },
    {
      "id": 4926,
      "verse_number": 25,
      "verse_key": "55:25",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179529,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4927,
      "verse_number": 26,
      "verse_key": "55:26",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179530,
          "resource_id": 33,
          "text": "Semua yang ada di bumi itu akan binasa,"
        }
      ]
    },
    {
      "id": 4928,
      "verse_number": 27,
      "verse_key": "55:27",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179531,
          "resource_id": 33,
          "text": "tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."
        }
      ]
    },
    {
      "id": 4929,
      "verse_number": 28,
      "verse_key": "55:28",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179532,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4930,
      "verse_number": 29,
      "verse_key": "55:29",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179533,
          "resource_id": 33,
          "text": "Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan.<sup foot_note=135772>1</sup>"
        }
      ]
    },
    {
      "id": 4931,
      "verse_number": 30,
      "verse_key": "55:30",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179209,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4932,
      "verse_number": 31,
      "verse_key": "55:31",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179249,
          "resource_id": 33,
          "text": "Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!"
        }
      ]
    },
    {
      "id": 4933,
      "verse_number": 32,
      "verse_key": "55:32",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179493,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4934,
      "verse_number": 33,
      "verse_key": "55:33",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179536,
          "resource_id": 33,
          "text": "Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah)."
        }
      ]
    },
    {
      "id": 4935,
      "verse_number": 34,
      "verse_key": "55:34",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179539,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4936,
      "verse_number": 35,
      "verse_key": "55:35",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179538,
          "resource_id": 33,
          "text": "Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya)."
        }
      ]
    },
    {
      "id": 4937,
      "verse_number": 36,
      "verse_key": "55:36",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179544,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4938,
      "verse_number": 37,
      "verse_key": "55:37",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179540,
          "resource_id": 33,
          "text": "Maka apabila langit telah terbelah dan menjadi merah mawar seperti (kilauan) minyak."
        }
      ]
    },
    {
      "id": 4939,
      "verse_number": 38,
      "verse_key": "55:38",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179541,
          "resource_id": 33,
          "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"
        }
      ]
    },
    {
      "id": 4940,
      "verse_number": 39,
      "verse_key": "55:39",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ",
      "chapter_id": 55,
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 179542,
          "resource_id": 33,
          "text": "Maka pada hari itu manusia dan jin tidak ditanya tentang dosanya.<sup foot_note=135773>1</sup>"
        }
      ]
    },
    {
