{
  "verses": [
    {
      "id": 4454,
      "verse_number": 40,
      "verse_key": "44:40",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178950,
          "resource_id": 33,
          "text": "Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,"
        }
      ]
    },
    {
      "id": 4455,
      "verse_number": 41,
      "verse_key": "44:41",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178951,
          "resource_id": 33,
          "text": "(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,"
        }
      ]
    },
    {
      "id": 4456,
      "verse_number": 42,
      "verse_key": "44:42",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178953,
          "resource_id": 33,
          "text": "kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang."
        }
      ]
    },
    {
      "id": 4457,
      "verse_number": 43,
      "verse_key": "44:43",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 177384,
          "resource_id": 33,
          "text": "Sungguh pohon zaqqūm itu,"
        }
      ]
    },
    {
      "id": 4458,
      "verse_number": 44,
      "verse_key": "44:44",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "طَعَامُ ٱلْأَثِيمِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178954,
          "resource_id": 33,
          "text": "makanan bagi orang yang banyak dosa."
        }
      ]
    },
    {
      "id": 4459,
      "verse_number": 45,
      "verse_key": "44:45",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178960,
          "resource_id": 33,
          "text": "Seperti cairan tembaga yang mendidih di dalam perut,"
        }
      ]
    },
    {
      "id": 4460,
      "verse_number": 46,
      "verse_key": "44:46",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَغَلْىِ ٱلْحَمِيمِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178955,
          "resource_id": 33,
          "text": "seperti mendidihnya air yang sangat panas."
        }
      ]
    },
    {
      "id": 4461,
      "verse_number": 47,
      "verse_key": "44:47",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178956,
          "resource_id": 33,
          "text": "\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,"
        }
      ]
    },
    {
      "id": 4462,
      "verse_number": 48,
      "verse_key": "44:48",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178957,
          "resource_id": 33,
          "text": "kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\""
        }
      ]
    },
    {
      "id": 4463,
      "verse_number": 49,
      "verse_key": "44:49",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178958,
          "resource_id": 33,
          "text": "\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\""
        }
      ]
    },
    {
      "id": 4464,
      "verse_number": 50,
      "verse_key": "44:50",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178961,
          "resource_id": 33,
          "text": "Sungguh, inilah azab yang dahulu kamu ragukan."
        }
      ]
    },
    {
      "id": 4465,
      "verse_number": 51,
      "verse_key": "44:51",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178962,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,"
        }
      ]
    },
    {
      "id": 4466,
      "verse_number": 52,
      "verse_key": "44:52",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّـٰتٍ وَعُيُونٍ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178963,
          "resource_id": 33,
          "text": "(yaitu) di dalam taman-taman dan mata air-mata air;"
        }
      ]
    },
    {
      "id": 4467,
      "verse_number": 53,
      "verse_key": "44:53",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178964,
          "resource_id": 33,
          "text": "mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan,"
        }
      ]
    },
    {
      "id": 4468,
      "verse_number": 54,
      "verse_key": "44:54",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178965,
          "resource_id": 33,
          "text": "demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah."
        }
      ]
    },
    {
      "id": 4469,
      "verse_number": 55,
      "verse_key": "44:55",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178966,
          "resource_id": 33,
          "text": "Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram,<sup foot_note=135750>1</sup>"
        }
      ]
    },
    {
      "id": 4470,
      "verse_number": 56,
      "verse_key": "44:56",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178967,
          "resource_id": 33,
          "text": "mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka,"
        }
      ]
    },
    {
      "id": 4471,
      "verse_number": 57,
      "verse_key": "44:57",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178972,
          "resource_id": 33,
          "text": "itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung."
        }
      ]
    },
    {
      "id": 4472,
      "verse_number": 58,
      "verse_key": "44:58",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178969,
          "resource_id": 33,
          "text": "Sungguh, Kami mudahkan Alquran itu dengan bahasamu agar mereka mendapat pelajaran."
        }
      ]
    },
    {
      "id": 4473,
      "verse_number": 59,
      "verse_key": "44:59",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ",
      "chapter_id": 44,
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 178970,
          "resource_id": 33,
          "text": "Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu."
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 20,
    "current_page": 1,
