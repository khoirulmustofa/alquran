{
  "verses": [
    {
      "id": 3139,
      "verse_number": 207,
      "verse_key": "26:207",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181772,
          "resource_id": 33,
          "text": "niscaya tidak berguna bagi mereka kenikmatan yang mereka rasakan."
        }
      ]
    },
    {
      "id": 3140,
      "verse_number": 208,
      "verse_key": "26:208",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183344,
          "resource_id": 33,
          "text": "Dan Kami tidak membinasakan suatu negeri, kecuali setelah ada orang-orang yang memberi peringatan kepadanya;"
        }
      ]
    },
    {
      "id": 3141,
      "verse_number": 209,
      "verse_key": "26:209",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "ذِكْرَىٰ وَمَا كُنَّا ظَـٰلِمِينَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181774,
          "resource_id": 33,
          "text": "untuk (menjadi) peringatan. Dan Kami tidak berlaku zalim."
        }
      ]
    },
    {
      "id": 3142,
      "verse_number": 210,
      "verse_key": "26:210",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَـٰطِينُ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183348,
          "resource_id": 33,
          "text": "Dan (Alquran) itu tidaklah dibawa turun oleh setan-setan."
        }
      ]
    },
    {
      "id": 3143,
      "verse_number": 211,
      "verse_key": "26:211",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183349,
          "resource_id": 33,
          "text": "Dan tidaklah pantas bagi mereka (Alquran itu), dan mereka pun tidak akan sanggup."
        }
      ]
    },
    {
      "id": 3144,
      "verse_number": 212,
      "verse_key": "26:212",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183347,
          "resource_id": 33,
          "text": "Sesungguhnya untuk mendengarkannya pun mereka dijauhkan."
        }
      ]
    },
    {
      "id": 3145,
      "verse_number": 213,
      "verse_key": "26:213",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183351,
          "resource_id": 33,
          "text": "Maka janganlah kamu menyeru (menyembah) tuhan selain Allah, nanti kamu termasuk orang-orang yang di azab."
        }
      ]
    },
    {
      "id": 3146,
      "verse_number": 214,
      "verse_key": "26:214",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181775,
          "resource_id": 33,
          "text": "Dan berilah peringatan kepada kerabat-kerabatmu (Muhammad) yang terdekat,"
        }
      ]
    },
    {
      "id": 3147,
      "verse_number": 215,
      "verse_key": "26:215",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183350,
          "resource_id": 33,
          "text": "dan rendahkanlah dirimu terhadap orang-orang yang beriman yang mengikutimu."
        }
      ]
    },
    {
      "id": 3148,
      "verse_number": 216,
      "verse_key": "26:216",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌ مِّمَّا تَعْمَلُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183346,
          "resource_id": 33,
          "text": "Kemudian jika mereka mendurhakaimu maka katakanlah (Muhammad), \"Sesungguhnya aku tidak bertanggung jawab terhadap apa yang kamu kerjakan.\""
        }
      ]
    },
    {
      "id": 3149,
      "verse_number": 217,
      "verse_key": "26:217",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181778,
          "resource_id": 33,
          "text": "Dan bertawakallah kepada (Allah) Yang Mahaperkasa, Maha penyayang,"
        }
      ]
    },
    {
      "id": 3150,
      "verse_number": 218,
      "verse_key": "26:218",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183339,
          "resource_id": 33,
          "text": "Yang melihat engkau ketika engkau berdiri (untuk salat),"
        }
      ]
    },
    {
      "id": 3151,
      "verse_number": 219,
      "verse_key": "26:219",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَتَقَلُّبَكَ فِى ٱلسَّـٰجِدِينَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181779,
          "resource_id": 33,
          "text": "dan (melihat) perubahan gerakan badanmu di antara orang-orang yang sujud."
        }
      ]
    },
    {
      "id": 3152,
      "verse_number": 220,
      "verse_key": "26:220",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181782,
          "resource_id": 33,
          "text": "Sungguh, Dia Maha Mendengar, Maha Mengetahui."
        }
      ]
    },
    {
      "id": 3153,
      "verse_number": 221,
      "verse_key": "26:221",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183325,
          "resource_id": 33,
          "text": "Maukah Aku beritakan kepadamu, kepada siapa setan-setan itu turun?"
        }
      ]
    },
    {
      "id": 3154,
      "verse_number": 222,
      "verse_key": "26:222",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183293,
          "resource_id": 33,
          "text": "Mereka (setan) turun kepada setiap pendusta yang banyak berdosa,"
        }
      ]
    },
    {
      "id": 3155,
      "verse_number": 223,
      "verse_key": "26:223",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 181786,
          "resource_id": 33,
          "text": "mereka menyampaikan hasil pendengaran mereka, sedangkan kebanyakan mereka orang-orang pendusta."
        }
      ]
    },
    {
      "id": 3156,
      "verse_number": 224,
      "verse_key": "26:224",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183360,
          "resource_id": 33,
          "text": "Dan penyair-penyair itu diikuti oleh orang-orang yang sesat."
        }
      ]
    },
    {
      "id": 3157,
      "verse_number": 225,
      "verse_key": "26:225",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍ يَهِيمُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183239,
          "resource_id": 33,
          "text": "Tidakkah engkau melihat bahwa mereka mengembara di setiap lembah,<sup foot_note=135542>1</sup>"
        }
      ]
    },
    {
      "id": 3158,
      "verse_number": 226,
      "verse_key": "26:226",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183357,
          "resource_id": 33,
          "text": "dan bahwa mereka mengatakan apa yang mereka sendiri tidak mengerjakan(nya)?"
        }
      ]
    },
    {
      "id": 3159,
      "verse_number": 227,
      "verse_key": "26:227",
      "hizb_number": 38,
      "rub_el_hizb_number": 150,
      "ruku_number": 326,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍ يَنقَلِبُونَ",
      "chapter_id": 26,
      "page_number": 376,
      "juz_number": 19,
      "translations": [
        {
          "id": 183358,
          "resource_id": 33,
          "text": "kecuali orang-orang (penyair-penyair) yang beriman dan berbuat kebajikan dan banyak mengingat Allah dan mendapat kemenangan setelah terzalimi (karena menjawab puisi-puisi orang-orang kafir). Dan orang-orang yang zalim kelak akan tahu ke tempat mana mereka akan kembali."
        }
      ]
    }
  ],
