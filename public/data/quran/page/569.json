{
  "verses": [
    {
      "id": 5386,
      "verse_number": 11,
      "verse_key": "70:11",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180190,
          "resource_id": 33,
          "text": "sedang mereka saling melihat. Pada hari itu, orang yang berdosa ingin sekiranya dia dapat menebus (dirinya) dari azab dengan anak-anaknya,"
        }
      ]
    },
    {
      "id": 5387,
      "verse_number": 12,
      "verse_key": "70:12",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 177545,
          "resource_id": 33,
          "text": "dan istrinya juga saudaranya,"
        }
      ]
    },
    {
      "id": 5388,
      "verse_number": 13,
      "verse_key": "70:13",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180191,
          "resource_id": 33,
          "text": "dan keluarga yang melindunginya (di dunia),"
        }
      ]
    },
    {
      "id": 5389,
      "verse_number": 14,
      "verse_key": "70:14",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180159,
          "resource_id": 33,
          "text": "dan orang-orang di bumi seluruhnya, kemudian mengharapkan (tebusan) itu dapat menyelamatkannya."
        }
      ]
    },
    {
      "id": 5390,
      "verse_number": 15,
      "verse_key": "70:15",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180192,
          "resource_id": 33,
          "text": "Sama sekali tidak! Sungguh, neraka itu api yang bergejolak,"
        }
      ]
    },
    {
      "id": 5391,
      "verse_number": 16,
      "verse_key": "70:16",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَزَّاعَةً لِّلشَّوَىٰ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180208,
          "resource_id": 33,
          "text": "yang mengelupaskan kulit kepala."
        }
      ]
    },
    {
      "id": 5392,
      "verse_number": 17,
      "verse_key": "70:17",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180193,
          "resource_id": 33,
          "text": "Yang memanggil orang yang membelakangi dan yang berpaling (dari agama),"
        }
      ]
    },
    {
      "id": 5393,
      "verse_number": 18,
      "verse_key": "70:18",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَمَعَ فَأَوْعَىٰٓ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180194,
          "resource_id": 33,
          "text": "dan orang yang mengumpulkan (harta benda) lalu menyimpannya.<sup foot_note=135815>1</sup>"
        }
      ]
    },
    {
      "id": 5394,
      "verse_number": 19,
      "verse_key": "70:19",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180195,
          "resource_id": 33,
          "text": "Sungguh, manusia diciptakan bersifat suka mengeluh."
        }
      ]
    },
    {
      "id": 5395,
      "verse_number": 20,
      "verse_key": "70:20",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180197,
          "resource_id": 33,
          "text": "Apabila dia ditimpa kesusahan dia berkeluh kesah,"
        }
      ]
    },
    {
      "id": 5396,
      "verse_number": 21,
      "verse_key": "70:21",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180198,
          "resource_id": 33,
          "text": "dan apabila mendapat kebaikan (harta) dia jadi kikir,"
        }
      ]
    },
    {
      "id": 5397,
      "verse_number": 22,
      "verse_key": "70:22",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلْمُصَلِّينَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180199,
          "resource_id": 33,
          "text": "kecuali orang-orang yang melaksanakan salat,"
        }
      ]
    },
    {
      "id": 5398,
      "verse_number": 23,
      "verse_key": "70:23",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180200,
          "resource_id": 33,
          "text": "mereka yang tetap setia melaksanakan salatnya,"
        }
      ]
    },
    {
      "id": 5399,
      "verse_number": 24,
      "verse_key": "70:24",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180201,
          "resource_id": 33,
          "text": "dan orang-orang yang dalam hartanya disiapkan bagian tertentu,"
        }
      ]
    },
    {
      "id": 5400,
      "verse_number": 25,
      "verse_key": "70:25",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180202,
          "resource_id": 33,
          "text": "bagi orang (miskin) yang meminta dan yang tidak meminta,"
        }
      ]
    },
    {
      "id": 5401,
      "verse_number": 26,
      "verse_key": "70:26",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180203,
          "resource_id": 33,
          "text": "dan orang-orang yang mempercayai hari pembalasan,"
        }
      ]
    },
    {
      "id": 5402,
      "verse_number": 27,
      "verse_key": "70:27",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180204,
          "resource_id": 33,
          "text": "dan orang-orang yang takut terhadap azab Tuhannya,"
        }
      ]
    },
    {
      "id": 5403,
      "verse_number": 28,
      "verse_key": "70:28",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180205,
          "resource_id": 33,
          "text": "sesungguhnya terhadap azab Tuhan mereka, tidak ada seseorang yang merasa aman (dari kedatangannya),"
        }
      ]
    },
    {
      "id": 5404,
      "verse_number": 29,
      "verse_key": "70:29",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 177454,
          "resource_id": 33,
          "text": "dan orang-orang yang memelihara kemaluannya,"
        }
      ]
    },
    {
      "id": 5405,
      "verse_number": 30,
      "verse_key": "70:30",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180207,
          "resource_id": 33,
          "text": "kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki<sup foot_note=135816>1</sup> maka sesungguhnya mereka tidak tercela."
        }
      ]
    },
    {
      "id": 5406,
      "verse_number": 31,
      "verse_key": "70:31",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180210,
          "resource_id": 33,
          "text": "Maka barangsiapa mencari di luar itu (seperti zina, homoseks, dan lesbian), mereka itulah orang-orang yang melampaui batas."
        }
      ]
    },
    {
      "id": 5407,
      "verse_number": 32,
      "verse_key": "70:32",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180209,
          "resource_id": 33,
          "text": "Dan orang-orang yang memelihara amanat dan janjinya,"
        }
      ]
    },
    {
      "id": 5408,
      "verse_number": 33,
      "verse_key": "70:33",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180211,
          "resource_id": 33,
          "text": "dan orang-orang yang berpegang teguh pada kesaksiannya,"
        }
      ]
    },
    {
      "id": 5409,
      "verse_number": 34,
      "verse_key": "70:34",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180212,
          "resource_id": 33,
          "text": "dan orang-orang yang memelihara salatnya."
        }
      ]
    },
    {
      "id": 5410,
      "verse_number": 35,
      "verse_key": "70:35",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180213,
          "resource_id": 33,
          "text": "Mereka itu dimuliakan di dalam surga."
        }
      ]
    },
    {
      "id": 5411,
      "verse_number": 36,
      "verse_key": "70:36",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180214,
          "resource_id": 33,
          "text": "Maka mengapa orang-orang kafir itu datang bergegas ke hadapanmu (Muhammad),"
        }
      ]
    },
    {
      "id": 5412,
      "verse_number": 37,
      "verse_key": "70:37",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180215,
          "resource_id": 33,
          "text": "dari kanan dan dari kiri dengan berkelompok-kelompok?<sup foot_note=135817>1</sup>"
        }
      ]
    },
    {
      "id": 5413,
      "verse_number": 38,
      "verse_key": "70:38",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180216,
          "resource_id": 33,
          "text": "Apakah setiap orang dari orang-orang kafir itu ingin masuk surga yang penuh kenikmatan?"
        }
      ]
    },
    {
      "id": 5414,
      "verse_number": 39,
      "verse_key": "70:39",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ",
      "chapter_id": 70,
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 180217,
          "resource_id": 33,
          "text": "tidak mungkin! Sesungguhnya Kami menciptakan mereka dari apa yang mereka ketahui.<sup foot_note=135818>1</sup>"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 30,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 30
  }
}