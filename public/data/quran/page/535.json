{
  "verses": [
    {
      "id": 4996,
      "verse_number": 17,
      "verse_key": "56:17",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179600,
          "resource_id": 33,
          "text": "Mereka dikelilingi oleh anak-anak muda yang tetap muda,"
        }
      ]
    },
    {
      "id": 4997,
      "verse_number": 18,
      "verse_key": "56:18",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179601,
          "resource_id": 33,
          "text": "dengan membawa gelas, cerek dan gelas besar (piala) berisi minuman yang diambil dari air yang mengalir,"
        }
      ]
    },
    {
      "id": 4998,
      "verse_number": 19,
      "verse_key": "56:19",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179602,
          "resource_id": 33,
          "text": "mereka tidak pening karenanya dan tidak pula mabuk,"
        }
      ]
    },
    {
      "id": 4999,
      "verse_number": 20,
      "verse_key": "56:20",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179605,
          "resource_id": 33,
          "text": "dan buah-buahan apa pun yang mereka pilih,"
        }
      ]
    },
    {
      "id": 5000,
      "verse_number": 21,
      "verse_key": "56:21",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179607,
          "resource_id": 33,
          "text": "dan daging burung apa pun yang mereka inginkan."
        }
      ]
    },
    {
      "id": 5001,
      "verse_number": 22,
      "verse_key": "56:22",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحُورٌ عِينٌ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179608,
          "resource_id": 33,
          "text": "dan ada bidadari-bidadari yang bermata indah,"
        }
      ]
    },
    {
      "id": 5002,
      "verse_number": 23,
      "verse_key": "56:23",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179611,
          "resource_id": 33,
          "text": "laksana mutiara yang tersimpan baik."
        }
      ]
    },
    {
      "id": 5003,
      "verse_number": 24,
      "verse_key": "56:24",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179609,
          "resource_id": 33,
          "text": "Sebagai balasan atas apa yang mereka kerjakan."
        }
      ]
    },
    {
      "id": 5004,
      "verse_number": 25,
      "verse_key": "56:25",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179610,
          "resource_id": 33,
          "text": "Di sana mereka tidak mendengar percakapan yang sia-sia maupun yang menimbulkan dosa,"
        }
      ]
    },
    {
      "id": 5005,
      "verse_number": 26,
      "verse_key": "56:26",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179613,
          "resource_id": 33,
          "text": "tetapi mereka mendengar ucapan salam."
        }
      ]
    },
    {
      "id": 5006,
      "verse_number": 27,
      "verse_key": "56:27",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179612,
          "resource_id": 33,
          "text": "Dan golongan kanan, alangkah mulianya golongan kanan itu."
        }
      ]
    },
    {
      "id": 5007,
      "verse_number": 28,
      "verse_key": "56:28",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى سِدْرٍ مَّخْضُودٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179614,
          "resource_id": 33,
          "text": "(Mereka) berada di antara pohon bidara yang tidak berduri,"
        }
      ]
    },
    {
      "id": 5008,
      "verse_number": 29,
      "verse_key": "56:29",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَطَلْحٍ مَّنضُودٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179615,
          "resource_id": 33,
          "text": "dan pohon pisang yang bersusun-susun (buahnya),"
        }
      ]
    },
    {
      "id": 5009,
      "verse_number": 30,
      "verse_key": "56:30",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَظِلٍّ مَّمْدُودٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179623,
          "resource_id": 33,
          "text": "dan naungan yang terbentang luas,"
        }
      ]
    },
    {
      "id": 5010,
      "verse_number": 31,
      "verse_key": "56:31",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآءٍ مَّسْكُوبٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179618,
          "resource_id": 33,
          "text": "dan air yang mengalir terus-menerus,"
        }
      ]
    },
    {
      "id": 5011,
      "verse_number": 32,
      "verse_key": "56:32",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179620,
          "resource_id": 33,
          "text": "dan buah-buahan yang banyak,"
        }
      ]
    },
    {
      "id": 5012,
      "verse_number": 33,
      "verse_key": "56:33",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179619,
          "resource_id": 33,
          "text": "yang tidak berhenti berbuah dan tidak terlarang mengambilnya,"
        }
      ]
    },
    {
      "id": 5013,
      "verse_number": 34,
      "verse_key": "56:34",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفُرُشٍ مَّرْفُوعَةٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179621,
          "resource_id": 33,
          "text": "dan kasur-kasur yang tebal lagi empuk."
        }
      ]
    },
    {
      "id": 5014,
      "verse_number": 35,
      "verse_key": "56:35",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179563,
          "resource_id": 33,
          "text": "Kami menciptakan mereka (bidadari-bidadari itu) secara langsung,<sup foot_note=135779>1</sup>"
        }
      ]
    },
    {
      "id": 5015,
      "verse_number": 36,
      "verse_key": "56:36",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 176271,
          "resource_id": 33,
          "text": "lalu Kami jadikan mereka perawan-perawan,"
        }
      ]
    },
    {
      "id": 5016,
      "verse_number": 37,
      "verse_key": "56:37",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عُرُبًا أَتْرَابًا",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 177658,
          "resource_id": 33,
          "text": "yang penuh cinta (dan) sebaya umurnya,"
        }
      ]
    },
    {
      "id": 5017,
      "verse_number": 38,
      "verse_key": "56:38",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 471,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 178451,
          "resource_id": 33,
          "text": "untuk golongan kanan,"
        }
      ]
    },
    {
      "id": 5018,
      "verse_number": 39,
      "verse_key": "56:39",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 178670,
          "resource_id": 33,
          "text": "segolongan besar dari orang-orang yang terdahulu,"
        }
      ]
    },
    {
      "id": 5019,
      "verse_number": 40,
      "verse_key": "56:40",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179624,
          "resource_id": 33,
          "text": "dan segolongan besar pula dari orang yang kemudian."
        }
      ]
    },
    {
      "id": 5020,
      "verse_number": 41,
      "verse_key": "56:41",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179626,
          "resource_id": 33,
          "text": "Dan golongan kiri, alangkah sengsaranya golongan kiri itu."
        }
      ]
    },
    {
      "id": 5021,
      "verse_number": 42,
      "verse_key": "56:42",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى سَمُومٍ وَحَمِيمٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179627,
          "resource_id": 33,
          "text": "(Mereka) dalam siksaan angin yang sangat panas dan air yang mendidih,"
        }
      ]
    },
    {
      "id": 5022,
      "verse_number": 43,
      "verse_key": "56:43",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَظِلٍّ مِّن يَحْمُومٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179631,
          "resource_id": 33,
          "text": "dan naungan asap yang hitam,"
        }
      ]
    },
    {
      "id": 5023,
      "verse_number": 44,
      "verse_key": "56:44",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 177459,
          "resource_id": 33,
          "text": "tidak sejuk dan tidak menyenangkan."
        }
      ]
    },
    {
      "id": 5024,
      "verse_number": 45,
      "verse_key": "56:45",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179628,
          "resource_id": 33,
          "text": "Sesungguhnya mereka sebelum itu (dahulu) hidup bermewah-mewah,"
        }
      ]
    },
    {
      "id": 5025,
      "verse_number": 46,
      "verse_key": "56:46",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179629,
          "resource_id": 33,
          "text": "dan mereka terus-menerus mengerjakan dosa yang besar,"
        }
      ]
    },
    {
      "id": 5026,
      "verse_number": 47,
      "verse_key": "56:47",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179630,
          "resource_id": 33,
          "text": "dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?"
        }
      ]
    },
    {
      "id": 5027,
      "verse_number": 48,
      "verse_key": "56:48",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "chapter_id": 56,
      "page_number": 535,
      "juz_number": 27,
      "translations": [
        {
          "id": 179633,
          "resource_id": 33,
          "text": "Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\""
        }
      ]
    },
    {
      "id": 5028,
      "verse_number": 49,
      "verse_key": "56:49",
      "hizb_number": 54,
      "rub_el_hizb_number": 214,
      "ruku_number": 472,
