{
  "verses": [
    {
      "id": 3044,
      "verse_number": 112,
      "verse_key": "26:112",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183195,
          "resource_id": 33,
          "text": "Dia (Nuh) menjawab, \"Tidak ada pengetahuanku tentang apa yang mereka kerjakan."
        }
      ]
    },
    {
      "id": 3045,
      "verse_number": 113,
      "verse_key": "26:113",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183286,
          "resource_id": 33,
          "text": "Perhitungan (amal perbuatan) mereka tidak lain hanyalah kepada Tuhanku, jika kamu menyadari."
        }
      ]
    },
    {
      "id": 3046,
      "verse_number": 114,
      "verse_key": "26:114",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183123,
          "resource_id": 33,
          "text": "Dan aku tidak akan mengusir orang-orang yang beriman."
        }
      ]
    },
    {
      "id": 3047,
      "verse_number": 115,
      "verse_key": "26:115",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنْ أَنَا۠ إِلَّا نَذِيرٌ مُّبِينٌ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181689,
          "resource_id": 33,
          "text": "Aku (ini) hanyalah pemberi peringatan yang jelas.\""
        }
      ]
    },
    {
      "id": 3048,
      "verse_number": 116,
      "verse_key": "26:116",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَـٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183285,
          "resource_id": 33,
          "text": "Mereka berkata, \"Wahai Nuh! Sungguh, jika engkau tidak (mau) berhenti, niscaya engkau termasuk orang yang dirajam (dilempari batu sampai mati).\""
        }
      ]
    },
    {
      "id": 3049,
      "verse_number": 117,
      "verse_key": "26:117",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 182406,
          "resource_id": 33,
          "text": "Dia (Nuh) berkata, \"Ya Tuhanku, sungguh kaumku telah mendustakan aku;"
        }
      ]
    },
    {
      "id": 3050,
      "verse_number": 118,
      "verse_key": "26:118",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183215,
          "resource_id": 33,
          "text": "maka berilah keputusan antara aku dengan mereka, dan selamatkanlah aku dan mereka yang beriman bersamaku.\""
        }
      ]
    },
    {
      "id": 3051,
      "verse_number": 119,
      "verse_key": "26:119",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَنجَيْنَـٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181693,
          "resource_id": 33,
          "text": "Kemudian Kami menyelamatkan Nuh dan orang-orang yang bersamanya di dalam kapal yang penuh muatan."
        }
      ]
    },
    {
      "id": 3052,
      "verse_number": 120,
      "verse_key": "26:120",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183284,
          "resource_id": 33,
          "text": "Kemudian setelah itu Kami tenggelamkan orang-orang yang tinggal."
        }
      ]
    },
    {
      "id": 3053,
      "verse_number": 121,
      "verse_key": "26:121",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183289,
          "resource_id": 33,
          "text": "Sungguh, pada yang demikian itu benar-benar terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman."
        }
      ]
    },
    {
      "id": 3054,
      "verse_number": 122,
      "verse_key": "26:122",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 321,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181696,
          "resource_id": 33,
          "text": "Dan sungguh, Tuhanmu, Dialah Yang Mahaperkasa, Maha penyayang."
        }
      ]
    },
    {
      "id": 3055,
      "verse_number": 123,
      "verse_key": "26:123",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183288,
          "resource_id": 33,
          "text": "(Kaum) 'Ād telah mendustakan para rasul."
        }
      ]
    },
    {
      "id": 3056,
      "verse_number": 124,
      "verse_key": "26:124",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183291,
          "resource_id": 33,
          "text": "Ketika saudara mereka Hud berkata kepada mereka, \"Mengapa kamu tidak bertakwa?"
        }
      ]
    },
    {
      "id": 3057,
      "verse_number": 125,
      "verse_key": "26:125",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181697,
          "resource_id": 33,
          "text": "Sungguh, aku ini seorang rasul kepercayaan (yang diutus) kepadamu,"
        }
      ]
    },
    {
      "id": 3058,
      "verse_number": 126,
      "verse_key": "26:126",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181700,
          "resource_id": 33,
          "text": "maka bertakwalah kepada Allah dan taatlah kepadaku."
        }
      ]
    },
    {
      "id": 3059,
      "verse_number": 127,
      "verse_key": "26:127",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183292,
          "resource_id": 33,
          "text": "Dan aku tidak minta imbalan kepadamu atas ajakan itu; imbalanku hanyalah dari Tuhan seluruh alam."
        }
      ]
    },
    {
      "id": 3060,
      "verse_number": 128,
      "verse_key": "26:128",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةً تَعْبَثُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183290,
          "resource_id": 33,
          "text": "Apakah kamu mendirikan istana-istana pada setiap tanah yang tinggi untuk kemegahan tanpa ditempati,"
        }
      ]
    },
    {
      "id": 3061,
      "verse_number": 129,
      "verse_key": "26:129",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181701,
          "resource_id": 33,
          "text": "dan kamu membuat benteng-benteng dengan harapan kamu hidup kekal?"
        }
      ]
    },
    {
      "id": 3062,
      "verse_number": 130,
      "verse_key": "26:130",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181703,
          "resource_id": 33,
          "text": "Dan apabila kamu menyiksa, maka kamu lakukan secara kejam dan bengis."
        }
      ]
    },
    {
      "id": 3063,
      "verse_number": 131,
      "verse_key": "26:131",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181704,
          "resource_id": 33,
          "text": "Maka bertakwalah kepada Allah dan taatlah kepadaku,"
        }
      ]
    },
    {
      "id": 3064,
      "verse_number": 132,
      "verse_key": "26:132",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181710,
          "resource_id": 33,
          "text": "dan tetaplah kamu bertakwa kepada-Nya yang telah menganugerahkan kepadamu apa yang kamu ketahui."
        }
      ]
    },
    {
      "id": 3065,
      "verse_number": 133,
      "verse_key": "26:133",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "أَمَدَّكُم بِأَنْعَـٰمٍ وَبَنِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183283,
          "resource_id": 33,
          "text": "Dia (Allah) telah menganugerahkan kepadamu hewan ternak dan anak-anak,"
        }
      ]
    },
    {
      "id": 3066,
      "verse_number": 134,
      "verse_key": "26:134",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَجَنَّـٰتٍ وَعُيُونٍ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 181711,
          "resource_id": 33,
          "text": "dan kebun-kebun, dan mata air,"
        }
      ]
    },
    {
      "id": 3067,
      "verse_number": 135,
      "verse_key": "26:135",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183268,
          "resource_id": 33,
          "text": "sesungguhnya aku takut kamu akan ditimpa azab pada hari yang besar.\""
        }
      ]
    },
    {
      "id": 3068,
      "verse_number": 136,
      "verse_key": "26:136",
      "hizb_number": 38,
      "rub_el_hizb_number": 149,
      "ruku_number": 322,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ",
      "chapter_id": 26,
      "page_number": 372,
      "juz_number": 19,
      "translations": [
        {
          "id": 183240,
          "resource_id": 33,
          "text": "Mereka menjawab, \"Sama saja bagi kami, apakah engkau memberi nasihat atau tidak memberi nasihat,"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 25,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 25
  }
}