{
  "verses": [
    {
      "id": 6099,
      "verse_number": 1,
      "verse_key": "95:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلتِّينِ وَٱلزَّيْتُونِ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181223,
          "resource_id": 33,
          "text": "Demi (buah) Tin dan (buah) Zaitun,<sup foot_note=135867>1</sup>"
        }
      ]
    },
    {
      "id": 6100,
      "verse_number": 2,
      "verse_key": "95:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181231,
          "resource_id": 33,
          "text": "demi gunung Sinai, <sup foot_note=135868>1</sup>"
        }
      ]
    },
    {
      "id": 6101,
      "verse_number": 3,
      "verse_key": "95:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181233,
          "resource_id": 33,
          "text": "dan demi negeri (Mekkah) yang aman ini."
        }
      ]
    },
    {
      "id": 6102,
      "verse_number": 4,
      "verse_key": "95:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181235,
          "resource_id": 33,
          "text": "Sungguh, Kami telah menciptakan manusia dalam bentuk yang sebaik-baiknya,"
        }
      ]
    },
    {
      "id": 6103,
      "verse_number": 5,
      "verse_key": "95:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181236,
          "resource_id": 33,
          "text": "kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya,"
        }
      ]
    },
    {
      "id": 6104,
      "verse_number": 6,
      "verse_key": "95:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181238,
          "resource_id": 33,
          "text": "kecuali orang-orang yang beriman dan mengerjakan kebajikan; maka mereka akan mendapat pahala yang tidak ada putus-putusnya."
        }
      ]
    },
    {
      "id": 6105,
      "verse_number": 7,
      "verse_key": "95:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181240,
          "resource_id": 33,
          "text": "Maka apa yang menyebabkan (mereka) mendustakanmu (tentang) hari pembalasan setelah (adanya keterangan-keterangan) itu?"
        }
      ]
    },
    {
      "id": 6106,
      "verse_number": 8,
      "verse_key": "95:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
      "chapter_id": 95,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181245,
          "resource_id": 33,
          "text": "Bukankah Allah Hakim yang paling adil?"
        }
      ]
    },
    {
      "id": 6107,
      "verse_number": 1,
      "verse_key": "96:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181249,
          "resource_id": 33,
          "text": "Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,"
        }
      ]
    },
    {
      "id": 6108,
      "verse_number": 2,
      "verse_key": "96:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181260,
          "resource_id": 33,
          "text": "Dia telah menciptakan manusia dari segumpal darah."
        }
      ]
    },
    {
      "id": 6109,
      "verse_number": 3,
      "verse_key": "96:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181262,
          "resource_id": 33,
          "text": "Bacalah, dan Tuhanmulah Yang Mahamulia."
        }
      ]
    },
    {
      "id": 6110,
      "verse_number": 4,
      "verse_key": "96:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181264,
          "resource_id": 33,
          "text": "Yang mengajar (manusia) dengan pena."
        }
      ]
    },
    {
      "id": 6111,
      "verse_number": 5,
      "verse_key": "96:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181115,
          "resource_id": 33,
          "text": "Dia mengajarkan manusia apa yang tidak diketahuinya."
        }
      ]
    },
    {
      "id": 6112,
      "verse_number": 6,
      "verse_key": "96:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181267,
          "resource_id": 33,
          "text": "Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,"
        }
      ]
    },
    {
      "id": 6113,
      "verse_number": 7,
      "verse_key": "96:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181269,
          "resource_id": 33,
          "text": "apabila melihat dirinya serba cukup."
        }
      ]
    },
    {
      "id": 6114,
      "verse_number": 8,
      "verse_key": "96:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181271,
          "resource_id": 33,
          "text": "Sungguh, hanya kepada Tuhanmulah tempat kembali(mu)."
        }
      ]
    },
    {
      "id": 6115,
      "verse_number": 9,
      "verse_key": "96:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181273,
          "resource_id": 33,
          "text": "Bagaimana pendapatmu tentang orang yang melarang?"
        }
      ]
    },
    {
      "id": 6116,
      "verse_number": 10,
      "verse_key": "96:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181275,
          "resource_id": 33,
          "text": "seorang hamba ketika dia melaksanakan salat,<sup foot_note=135869>1</sup>"
        }
      ]
    },
    {
      "id": 6117,
      "verse_number": 11,
      "verse_key": "96:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181258,
          "resource_id": 33,
          "text": "bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),"
        }
      ]
    },
    {
      "id": 6118,
      "verse_number": 12,
      "verse_key": "96:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181250,
          "resource_id": 33,
          "text": "atau dia menyuruh bertakwa (kepada Allah)?"
        }
      ]
    },
    {
      "id": 6119,
      "verse_number": 13,
      "verse_key": "96:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181251,
          "resource_id": 33,
          "text": "Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?"
        }
      ]
    },
    {
      "id": 6120,
      "verse_number": 14,
      "verse_key": "96:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181252,
          "resource_id": 33,
          "text": "Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?"
        }
      ]
    },
    {
      "id": 6121,
      "verse_number": 15,
      "verse_key": "96:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181253,
          "resource_id": 33,
          "text": "Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),"
        }
      ]
    },
    {
      "id": 6122,
      "verse_number": 16,
      "verse_key": "96:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181254,
          "resource_id": 33,
          "text": "(yaitu) ubun-ubun orang yang mendustakan dan durhaka."
        }
      ]
    },
    {
      "id": 6123,
      "verse_number": 17,
      "verse_key": "96:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181255,
          "resource_id": 33,
          "text": "Maka biarlah dia memanggil golongannya (untuk menolongnya),"
        }
      ]
    },
    {
      "id": 6124,
      "verse_number": 18,
      "verse_key": "96:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181256,
          "resource_id": 33,
          "text": "kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa)"
        }
      ]
    },
    {
      "id": 6125,
      "verse_number": 19,
      "verse_key": "96:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": 14,
      "text_uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "chapter_id": 96,
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 181257,
          "resource_id": 33,
          "text": "sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah)."
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 26,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
