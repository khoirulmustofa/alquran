{
  "verses": [
    {
      "id": 5543,
      "verse_number": 48,
      "verse_key": "74:48",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180489,
          "resource_id": 33,
          "text": "Maka tidak berguna lagi bagi mereka syafaat (pertolongan) dari orang-orang yang memberikan syafaat."
        }
      ]
    },
    {
      "id": 5544,
      "verse_number": 49,
      "verse_key": "74:49",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180490,
          "resource_id": 33,
          "text": "Lalu mengapa mereka (orang-orang kafir) berpaling dari peringatan (Allah)?"
        }
      ]
    },
    {
      "id": 5545,
      "verse_number": 50,
      "verse_key": "74:50",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180493,
          "resource_id": 33,
          "text": "seakan-akan mereka keledai liar yang lari terkejut,"
        }
      ]
    },
    {
      "id": 5546,
      "verse_number": 51,
      "verse_key": "74:51",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَرَّتْ مِن قَسْوَرَةٍۭ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180494,
          "resource_id": 33,
          "text": "lari dari singa."
        }
      ]
    },
    {
      "id": 5547,
      "verse_number": 52,
      "verse_key": "74:52",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180495,
          "resource_id": 33,
          "text": "Bahkan setiap orang dari mereka ingin agar diberikan kepadanya lembaran-lembaran (kitab) yang terbuka."
        }
      ]
    },
    {
      "id": 5548,
      "verse_number": 53,
      "verse_key": "74:53",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180498,
          "resource_id": 33,
          "text": "Tidak! Sebenarnya mereka tidak takut kepada akhirat."
        }
      ]
    },
    {
      "id": 5549,
      "verse_number": 54,
      "verse_key": "74:54",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180497,
          "resource_id": 33,
          "text": "Tidak! Sesungguhnya (Alquran) itu benar-benar suatu peringatan."
        }
      ]
    },
    {
      "id": 5550,
      "verse_number": 55,
      "verse_key": "74:55",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180499,
          "resource_id": 33,
          "text": "Maka barangsiapa menghendaki, tentu dia mengambil pelajaran darinya."
        }
      ]
    },
    {
      "id": 5551,
      "verse_number": 56,
      "verse_key": "74:56",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ",
      "chapter_id": 74,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180500,
          "resource_id": 33,
          "text": "Dan mereka tidak akan mengambil pelajaran darinya (Alquran) kecuali (jika) Allah menghendakinya. Dialah Tuhan yang patut (kita) bertakwa kepada-Nya dan yang berhak memberi ampun."
        }
      ]
    },
    {
      "id": 5552,
      "verse_number": 1,
      "verse_key": "75:1",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 181880,
          "resource_id": 33,
          "text": "Aku bersumpah dengan hari Kiamat,"
        }
      ]
    },
    {
      "id": 5553,
      "verse_number": 2,
      "verse_key": "75:2",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180554,
          "resource_id": 33,
          "text": "dan aku bersumpah demi jiwa yang selalu menyesali (dirinya sendiri)."
        }
      ]
    },
    {
      "id": 5554,
      "verse_number": 3,
      "verse_key": "75:3",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180539,
          "resource_id": 33,
          "text": "Apakah manusia mengira, bahwa Kami tidak akan mengumpulkan (kembali) tulang belulangnya?"
        }
      ]
    },
    {
      "id": 5555,
      "verse_number": 4,
      "verse_key": "75:4",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180552,
          "resource_id": 33,
          "text": "(Bahkan) Kami mampu menyusun (kembali) jari jemarinya dengan sempurna."
        }
      ]
    },
    {
      "id": 5556,
      "verse_number": 5,
      "verse_key": "75:5",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 177478,
          "resource_id": 33,
          "text": "Tetapi manusia hendak membuat maksiat terus menerus."
        }
      ]
    },
    {
      "id": 5557,
      "verse_number": 6,
      "verse_key": "75:6",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180556,
          "resource_id": 33,
          "text": "Dia bertanya, \"Kapankah hari Kiamat itu?\""
        }
      ]
    },
    {
      "id": 5558,
      "verse_number": 7,
      "verse_key": "75:7",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180558,
          "resource_id": 33,
          "text": "Maka apabila mata terbelalak (ketakutan),"
        }
      ]
    },
    {
      "id": 5559,
      "verse_number": 8,
      "verse_key": "75:8",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَخَسَفَ ٱلْقَمَرُ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180560,
          "resource_id": 33,
          "text": "dan bulan pun telah hilang cahayanya,"
        }
      ]
    },
    {
      "id": 5560,
      "verse_number": 9,
      "verse_key": "75:9",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180584,
          "resource_id": 33,
          "text": "lalu matahari dan bulan dikumpulkan,"
        }
      ]
    },
    {
      "id": 5561,
      "verse_number": 10,
      "verse_key": "75:10",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180602,
          "resource_id": 33,
          "text": "pada hari itu manusia berkata, \"Ke mana tempat pelarian?\""
        }
      ]
    },
    {
      "id": 5562,
      "verse_number": 11,
      "verse_key": "75:11",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَا وَزَرَ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180524,
          "resource_id": 33,
          "text": "Tidak! Tidak ada tempat berlindung!"
        }
      ]
    },
    {
      "id": 5563,
      "verse_number": 12,
      "verse_key": "75:12",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180515,
          "resource_id": 33,
          "text": "Hanya kepada Tuhanmu tempat kembali pada hari itu."
        }
      ]
    },
    {
      "id": 5564,
      "verse_number": 13,
      "verse_key": "75:13",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180516,
          "resource_id": 33,
          "text": "Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya."
        }
      ]
    },
    {
      "id": 5565,
      "verse_number": 14,
      "verse_key": "75:14",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180517,
          "resource_id": 33,
          "text": "Bahkan manusia menjadi saksi atas dirinya sendiri,<sup foot_note=135831>1</sup>"
        }
      ]
    },
    {
      "id": 5566,
      "verse_number": 15,
      "verse_key": "75:15",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180518,
          "resource_id": 33,
          "text": "dan meskipun dia mengemukakan alasan-alasannya."
        }
      ]
    },
    {
      "id": 5567,
      "verse_number": 16,
      "verse_key": "75:16",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180519,
          "resource_id": 33,
          "text": "Jangan engkau (Muhammad) gerakkan lidahmu (untuk membaca Alquran) karena hendak cepat-cepat (menguasai)nya."
        }
      ]
    },
    {
      "id": 5568,
      "verse_number": 17,
      "verse_key": "75:17",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180520,
          "resource_id": 33,
          "text": "Sesungguhnya Kami yang akan mengumpulkannya (di dadamu) dan membacakannya."
        }
      ]
    },
    {
      "id": 5569,
      "verse_number": 18,
      "verse_key": "75:18",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180521,
          "resource_id": 33,
          "text": "Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu."
        }
      ]
    },
    {
      "id": 5570,
      "verse_number": 19,
      "verse_key": "75:19",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "chapter_id": 75,
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 180522,
          "resource_id": 33,
          "text": "Kemudian sesungguhnya Kami yang akan menjelaskannya."
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 28,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 28
  }
}