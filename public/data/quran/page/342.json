{
  "verses": [
    {
      "id": 2674,
      "verse_number": 1,
      "verse_key": "23:1",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": " قَدْ أَفْلَحَ ٱلْمُؤْمِنُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182933,
          "resource_id": 33,
          "text": "Sungguh beruntung orang-orang yang beriman,"
        }
      ]
    },
    {
      "id": 2675,
      "verse_number": 2,
      "verse_key": "23:2",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ فِى صَلَاتِهِمْ خَـٰشِعُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182973,
          "resource_id": 33,
          "text": "(yaitu) orang yang khusyuk dalam salatnya,"
        }
      ]
    },
    {
      "id": 2676,
      "verse_number": 3,
      "verse_key": "23:3",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ عَنِ ٱللَّغْوِ مُعْرِضُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182995,
          "resource_id": 33,
          "text": "dan orang yang menjauhkan diri dari (perbuatan dan perkataan) yang tidak berguna,"
        }
      ]
    },
    {
      "id": 2677,
      "verse_number": 4,
      "verse_key": "23:4",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِلزَّكَوٰةِ فَـٰعِلُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182925,
          "resource_id": 33,
          "text": "dan orang yang menunaikan zakat,"
        }
      ]
    },
    {
      "id": 2678,
      "verse_number": 5,
      "verse_key": "23:5",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 183087,
          "resource_id": 33,
          "text": "dan orang yang memelihara kemaluannya,"
        }
      ]
    },
    {
      "id": 2679,
      "verse_number": 6,
      "verse_key": "23:6",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 183025,
          "resource_id": 33,
          "text": "kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki;<sup foot_note=135501>1</sup>maka sesungguhnya mereka tidak tercela."
        }
      ]
    },
    {
      "id": 2680,
      "verse_number": 7,
      "verse_key": "23:7",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 183036,
          "resource_id": 33,
          "text": "Tetapi barang siapa mencari di balik itu (zina, dan sebagainya), maka mereka itulah orang-orang yang melampaui batas."
        }
      ]
    },
    {
      "id": 2681,
      "verse_number": 8,
      "verse_key": "23:8",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182695,
          "resource_id": 33,
          "text": "Dan (sungguh beruntung) orang yang memelihara amanat-amanat dan janjinya,"
        }
      ]
    },
    {
      "id": 2682,
      "verse_number": 9,
      "verse_key": "23:9",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَوَٰتِهِمْ يُحَافِظُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 177653,
          "resource_id": 33,
          "text": "serta orang yang memelihara salatnya."
        }
      ]
    },
    {
      "id": 2683,
      "verse_number": 10,
      "verse_key": "23:10",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ هُمُ ٱلْوَٰرِثُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182923,
          "resource_id": 33,
          "text": "Mereka itulah orang yang akan mewarisi,"
        }
      ]
    },
    {
      "id": 2684,
      "verse_number": 11,
      "verse_key": "23:11",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ يَرِثُونَ ٱلْفِرْدَوْسَ هُمْ فِيهَا خَـٰلِدُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182949,
          "resource_id": 33,
          "text": "(yakni) yang akan mewarisi (surga) Firdaus. Mereka kekal di dalamnya."
        }
      ]
    },
    {
      "id": 2685,
      "verse_number": 12,
      "verse_key": "23:12",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ مِن سُلَـٰلَةٍ مِّن طِينٍ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182965,
          "resource_id": 33,
          "text": "Dan sungguh, Kami telah menciptakan manusia dari saripati (berasal) dari tanah."
        }
      ]
    },
    {
      "id": 2686,
      "verse_number": 13,
      "verse_key": "23:13",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ جَعَلْنَـٰهُ نُطْفَةً فِى قَرَارٍ مَّكِينٍ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182968,
          "resource_id": 33,
          "text": "Kemudian Kami menjadikannya air mani (yang disimpan) dalam tempat yang kokoh (rahim)."
        }
      ]
    },
    {
      "id": 2687,
      "verse_number": 14,
      "verse_key": "23:14",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةً فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةً فَخَلَقْنَا ٱلْمُضْغَةَ عِظَـٰمًا فَكَسَوْنَا ٱلْعِظَـٰمَ لَحْمًا ثُمَّ أَنشَأْنَـٰهُ خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ أَحْسَنُ ٱلْخَـٰلِقِينَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182967,
          "resource_id": 33,
          "text": "Kemudian, air mani itu Kami jadikan sesuatu yang melekat, lalu sesuatu yang melekat itu Kami jadikan segumpal daging, dan segumpal daging itu lalu Kami jadikan tulang belulang, lalu tulang belulang itu Kami bungkus dengan daging. Kemudian, Kami menjadikannya makhluk yang (berbentuk) lain. Mahasuci Allah, Pencipta yang paling baik."
        }
      ]
    },
    {
      "id": 2688,
      "verse_number": 15,
      "verse_key": "23:15",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّكُم بَعْدَ ذَٰلِكَ لَمَيِّتُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182961,
          "resource_id": 33,
          "text": "Kemudian setelah itu, sungguh kamu pasti mati."
        }
      ]
    },
    {
      "id": 2689,
      "verse_number": 16,
      "verse_key": "23:16",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ تُبْعَثُونَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182954,
          "resource_id": 33,
          "text": "Kemudian, sungguh kamu akan dibangkitkan (dari kuburmu) pada hari Kiamat."
        }
      ]
    },
    {
      "id": 2690,
      "verse_number": 17,
      "verse_key": "23:17",
      "hizb_number": 35,
      "rub_el_hizb_number": 137,
      "ruku_number": 295,
      "manzil_number": 4,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلْخَلْقِ غَـٰفِلِينَ",
      "chapter_id": 23,
      "page_number": 342,
      "juz_number": 18,
      "translations": [
        {
          "id": 182971,
          "resource_id": 33,
          "text": "Dan sungguh, kami telah menciptakan tujuh (lapis) langit di atas kamu, dan Kami tidaklah lengah terhadap ciptaan (Kami)."
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 17,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 17
  }
}