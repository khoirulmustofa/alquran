{
  "verses": [
    {
      "id": 3789,
      "verse_number": 1,
      "verse_key": "37:1",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": " وَٱلصَّـٰٓفَّـٰتِ صَفًّا",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178175,
          "resource_id": 33,
          "text": "Demi (rombongan malaikat) yang berbaris bersaf-saf,"
        }
      ]
    },
    {
      "id": 3790,
      "verse_number": 2,
      "verse_key": "37:2",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱلزَّٰجِرَٰتِ زَجْرًا",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178257,
          "resource_id": 33,
          "text": "demi (rombongan) yang mencegah dengan sungguh-sungguh,"
        }
      ]
    },
    {
      "id": 3791,
      "verse_number": 3,
      "verse_key": "37:3",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱلتَّـٰلِيَـٰتِ ذِكْرًا",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178265,
          "resource_id": 33,
          "text": "demi (rombongan) yang membacakan peringatan,"
        }
      ]
    },
    {
      "id": 3792,
      "verse_number": 4,
      "verse_key": "37:4",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178285,
          "resource_id": 33,
          "text": "sungguh, Tuhanmu benar-benar Esa."
        }
      ]
    },
    {
      "id": 3793,
      "verse_number": 5,
      "verse_key": "37:5",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178288,
          "resource_id": 33,
          "text": "Tuhan langit dan bumi dan apa yang berada di antara keduanya dan Tuhan tempat-tempat terbitnya matahari."
        }
      ]
    },
    {
      "id": 3794,
      "verse_number": 6,
      "verse_key": "37:6",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178298,
          "resource_id": 33,
          "text": "Sesungguhnya Kami telah menghias langit dunia (yang terdekat), dengan hiasan bintang-bintang."
        }
      ]
    },
    {
      "id": 3795,
      "verse_number": 7,
      "verse_key": "37:7",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178321,
          "resource_id": 33,
          "text": "Dan (Kami) telah menjaganya dari setiap setan yang durhaka,"
        }
      ]
    },
    {
      "id": 3796,
      "verse_number": 8,
      "verse_key": "37:8",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178322,
          "resource_id": 33,
          "text": "mereka (setan-setan itu) tidak dapat mendengar (pembicaraan) para malaikat dan mereka dilempari dari segala penjuru,"
        }
      ]
    },
    {
      "id": 3797,
      "verse_number": 9,
      "verse_key": "37:9",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 177348,
          "resource_id": 33,
          "text": "untuk mengusir mereka dan mereka akan mendapat azab yang kekal,"
        }
      ]
    },
    {
      "id": 3798,
      "verse_number": 10,
      "verse_key": "37:10",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178176,
          "resource_id": 33,
          "text": "kecuali (setan) yang mencuri (pembicaraan); maka ia dikejar oleh bintang yang menyala."
        }
      ]
    },
    {
      "id": 3799,
      "verse_number": 11,
      "verse_key": "37:11",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 181835,
          "resource_id": 33,
          "text": "Maka tanyakanlah kepada mereka (musyrik Mekkah), \"Apakah penciptaan mereka yang lebih sulit ataukah apa<sup foot_note=135677>1</sup> yang telah Kami ciptakan?\" Sesungguhnya Kami telah menciptakan mereka dari tanah liat."
        }
      ]
    },
    {
      "id": 3800,
      "verse_number": 12,
      "verse_key": "37:12",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178193,
          "resource_id": 33,
          "text": "Bahkan engkau (Muhammad) menjadi heran (terhadap keingkaran mereka) dan mereka menghinakan (engkau)."
        }
      ]
    },
    {
      "id": 3801,
      "verse_number": 13,
      "verse_key": "37:13",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178202,
          "resource_id": 33,
          "text": "Dan apabila mereka diberi peringatan, mereka tidak mengindahkannya."
        }
      ]
    },
    {
      "id": 3802,
      "verse_number": 14,
      "verse_key": "37:14",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178213,
          "resource_id": 33,
          "text": "Dan apabila mereka melihat suatu tanda (kebesaran) Allah, mereka memperolok-olokan."
        }
      ]
    },
    {
      "id": 3803,
      "verse_number": 15,
      "verse_key": "37:15",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178225,
          "resource_id": 33,
          "text": "Dan mereka berkata, \"ini tidak lain hanyalah sihir yang nyata."
        }
      ]
    },
    {
      "id": 3804,
      "verse_number": 16,
      "verse_key": "37:16",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178169,
          "resource_id": 33,
          "text": "Apabila kami telah mati dan telah menjadi tanah dan tulang-belulang, apakah benar kami akan dibangkitkan (kembali)?"
        }
      ]
    },
    {
      "id": 3805,
      "verse_number": 17,
      "verse_key": "37:17",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178236,
          "resource_id": 33,
          "text": "dan apakah nenek moyang kami yang telah terdahulu (akan dibangkitkan pula)?\""
        }
      ]
    },
    {
      "id": 3806,
      "verse_number": 18,
      "verse_key": "37:18",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178247,
          "resource_id": 33,
          "text": "Katakanlah (Muhammad), \"Ya, dan kamu akan terhina.\""
        }
      ]
    },
    {
      "id": 3807,
      "verse_number": 19,
      "verse_key": "37:19",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178251,
          "resource_id": 33,
          "text": "Maka sesungguhnya kebangkitan itu hanya dengan satu teriakan saja; maka seketika itu mereka melihatnya."
        }
      ]
    },
    {
      "id": 3808,
      "verse_number": 20,
      "verse_key": "37:20",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178254,
          "resource_id": 33,
          "text": "Dan mereka berkata, \"Alangkah celaka kami! (Kiranya) inilah hari pembalasan itu.\""
        }
      ]
    },
    {
      "id": 3809,
      "verse_number": 21,
      "verse_key": "37:21",
      "hizb_number": 45,
      "rub_el_hizb_number": 178,
      "ruku_number": 388,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178255,
          "resource_id": 33,
          "text": "Inilah hari keputusan<sup foot_note=135678>1</sup> yang dahulu kamu dustakan."
        }
      ]
    },
    {
      "id": 3810,
      "verse_number": 22,
      "verse_key": "37:22",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 389,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178256,
          "resource_id": 33,
          "text": "(Diperintahkan kepada malaikat), \"Kumpulkanlah orang-orang yang zalim beserta teman sejawat mereka dan apa yang dahulu mereka sembah,"
        }
      ]
    },
    {
      "id": 3811,
      "verse_number": 23,
      "verse_key": "37:23",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 389,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 178260,
          "resource_id": 33,
          "text": "selain Allah, lalu tunjukkanlah kepada mereka jalan ke nereka."
        }
      ]
    },
    {
      "id": 3812,
      "verse_number": 24,
      "verse_key": "37:24",
      "hizb_number": 45,
      "rub_el_hizb_number": 179,
      "ruku_number": 389,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ",
      "chapter_id": 37,
      "page_number": 446,
      "juz_number": 23,
      "translations": [
        {
          "id": 177283,
          "resource_id": 33,
          "text": "Tahanlah mereka (di tempat perhentian), sesungguhnya mereka akan ditanya,"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 24,
    "current_page": 1,
