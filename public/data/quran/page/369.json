{
  "verses": [
    {
      "id": 2972,
      "verse_number": 40,
      "verse_key": "26:40",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183373,
          "resource_id": 33,
          "text": "agar kita mengikuti para pesihir itu, jika mereka yang menang.\""
        }
      ]
    },
    {
      "id": 2973,
      "verse_number": 41,
      "verse_key": "26:41",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَـٰلِبِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181797,
          "resource_id": 33,
          "text": "Maka ketika para pesihir datang, mereka berkata kepada Fir'aun, \"Apakah kami benar-benar akan mendapat imbalan yang besar jika kami yang menang?\""
        }
      ]
    },
    {
      "id": 2974,
      "verse_number": 42,
      "verse_key": "26:42",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183370,
          "resource_id": 33,
          "text": "Dia (Fir'aun) menjawab, \"Ya, dan bahkan kamu pasti akan mendapat kedudukan yang dekat (dariku).\""
        }
      ]
    },
    {
      "id": 2975,
      "verse_number": 43,
      "verse_key": "26:43",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183378,
          "resource_id": 33,
          "text": "Dia (Musa) berkata kepada mereka, \"Lemparkanlah apa yang hendak kamu lemparkan.\""
        }
      ]
    },
    {
      "id": 2976,
      "verse_number": 44,
      "verse_key": "26:44",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَـٰلِبُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181803,
          "resource_id": 33,
          "text": "Lalu mereka melemparkan tali-temali dan tongkat-tongkat mereka seraya berkata, \"Demi kemuliaan Fir'aun, pasti kamilah yang akan menang.\""
        }
      ]
    },
    {
      "id": 2977,
      "verse_number": 45,
      "verse_key": "26:45",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183379,
          "resource_id": 33,
          "text": "Kemudian Musa melemparkan tongkatnya, maka tiba-tiba ia menelan benda-benda palsu yang mereka ada-adakan itu.<sup foot_note=135537>1</sup>"
        }
      ]
    },
    {
      "id": 2978,
      "verse_number": 46,
      "verse_key": "26:46",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأُلْقِىَ ٱلسَّحَرَةُ سَـٰجِدِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183380,
          "resource_id": 33,
          "text": "Maka menyungkurlah para pesihir itu, bersujud,"
        }
      ]
    },
    {
      "id": 2979,
      "verse_number": 47,
      "verse_key": "26:47",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَـٰلَمِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183377,
          "resource_id": 33,
          "text": "mereka berkata, \"Kami beriman kepada Tuhan seluruh alam,"
        }
      ]
    },
    {
      "id": 2980,
      "verse_number": 48,
      "verse_key": "26:48",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "رَبِّ مُوسَىٰ وَهَـٰرُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 177717,
          "resource_id": 33,
          "text": "(yaitu) Tuhannya Musa dan Harun.\""
        }
      ]
    },
    {
      "id": 2981,
      "verse_number": 49,
      "verse_key": "26:49",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَـٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183381,
          "resource_id": 33,
          "text": "Dia (Fir'aun) berkata, \"Mengapa kamu beriman kepada Musa sebelum aku memberi izin kepadamu? Sesungguhnya dia pemimpinmu yang mengajarkan sihir kepadamu. Nanti kamu pasti akan tahu (akibat perbuatanmu). Pasti akan kupotong tangan dan kakimu bersilang dan sungguh akan aku salib semuanya.\""
        }
      ]
    },
    {
      "id": 2982,
      "verse_number": 50,
      "verse_key": "26:50",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ لَا ضَيْرَ ۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183354,
          "resource_id": 33,
          "text": "Mereka berkata, \"Tidak ada yang kami takutkan, karena kami akan kembali kepada Tuhan kami."
        }
      ]
    },
    {
      "id": 2983,
      "verse_number": 51,
      "verse_key": "26:51",
      "hizb_number": 37,
      "rub_el_hizb_number": 147,
      "ruku_number": 318,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَـٰيَـٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183386,
          "resource_id": 33,
          "text": "Sesungguhnya kami sangat menginginkan sekiranya Tuhan kami akan mengampuni kesalahan kami, karena menjadi orang yang pertama-tama beriman.\""
        }
      ]
    },
    {
      "id": 2984,
      "verse_number": 52,
      "verse_key": "26:52",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "۞ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183387,
          "resource_id": 33,
          "text": "Dan Kami wahyukan (perintahkan) kepada Musa, \"Pergilah pada malam hari dengan membawa hamba-hamba-Ku (Bani Israil), sebab pasti kamu akan dikejar.\""
        }
      ]
    },
    {
      "id": 2985,
      "verse_number": 53,
      "verse_key": "26:53",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَرْسَلَ فِرْعَوْنُ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181805,
          "resource_id": 33,
          "text": "Kemudian Fir'aun mengirimkan orang ke kota-kota untuk mengumpulkan (bala tentaranya)."
        }
      ]
    },
    {
      "id": 2986,
      "verse_number": 54,
      "verse_key": "26:54",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰٓؤُلَآءِ لَشِرْذِمَةٌ قَلِيلُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183385,
          "resource_id": 33,
          "text": "(Fir'aun berkata), \"Sesungguhnya mereka (Bani Israil) hanya sekelompok kecil,"
        }
      ]
    },
    {
      "id": 2987,
      "verse_number": 55,
      "verse_key": "26:55",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُمْ لَنَا لَغَآئِظُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183389,
          "resource_id": 33,
          "text": "dan sesungguhnya mereka telah berbuat hal-hal yang menimbulkan amarah kita,"
        }
      ]
    },
    {
      "id": 2988,
      "verse_number": 56,
      "verse_key": "26:56",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّا لَجَمِيعٌ حَـٰذِرُونَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181806,
          "resource_id": 33,
          "text": "dan sesungguhnya kita semua tanpa kecuali harus selalu waspada.\""
        }
      ]
    },
    {
      "id": 2989,
      "verse_number": 57,
      "verse_key": "26:57",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَخْرَجْنَـٰهُم مِّن جَنَّـٰتٍ وَعُيُونٍ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183390,
          "resource_id": 33,
          "text": "Kemudian, Kami keluarkan mereka (Fir'aun dan kaumnya) dari taman-taman dan mata air,"
        }
      ]
    },
    {
      "id": 2990,
      "verse_number": 58,
      "verse_key": "26:58",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "وَكُنُوزٍ وَمَقَامٍ كَرِيمٍ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181809,
          "resource_id": 33,
          "text": "dan (dari) harta kekayaan dan kedudukan yang mulia,<sup foot_note=135538>1</sup>"
        }
      ]
    },
    {
      "id": 2991,
      "verse_number": 59,
      "verse_key": "26:59",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ وَأَوْرَثْنَـٰهَا بَنِىٓ إِسْرَٰٓءِيلَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 183388,
          "resource_id": 33,
          "text": "demikianlah, dan Kami anugerahkan semuanya (itu) kepada Bani Israil.<sup foot_note=135539>1</sup>"
        }
      ]
    },
    {
      "id": 2992,
      "verse_number": 60,
      "verse_key": "26:60",
      "hizb_number": 37,
      "rub_el_hizb_number": 148,
      "ruku_number": 319,
      "manzil_number": 5,
      "sajdah_number": null,
      "text_uthmani": "فَأَتْبَعُوهُم مُّشْرِقِينَ",
      "chapter_id": 26,
      "page_number": 369,
      "juz_number": 19,
      "translations": [
        {
          "id": 181810,
          "resource_id": 33,
          "text": "Lalu (Fir'aun dan bala tentaranya) dapat menyusul mereka pada waktu matahari terbit."
        }
      ]
    }
  ],
