{
  "verses": [
    {
      "id": 5642,
      "verse_number": 20,
      "verse_key": "77:20",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180615,
          "resource_id": 33,
          "text": "Bukankah Kami menciptakan kamu dari air yang hina (mani),"
        }
      ]
    },
    {
      "id": 5643,
      "verse_number": 21,
      "verse_key": "77:21",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180616,
          "resource_id": 33,
          "text": "kemudian Kami letakkan ia dalam tempat yang kokoh (rahim),"
        }
      ]
    },
    {
      "id": 5644,
      "verse_number": 22,
      "verse_key": "77:22",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180617,
          "resource_id": 33,
          "text": "sampai waktu yang ditentukan,"
        }
      ]
    },
    {
      "id": 5645,
      "verse_number": 23,
      "verse_key": "77:23",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180618,
          "resource_id": 33,
          "text": "lalu Kami tentukan (bentuknya), maka (Kamilah) sebaik-baik yang menentukan."
        }
      ]
    },
    {
      "id": 5646,
      "verse_number": 24,
      "verse_key": "77:24",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180619,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5647,
      "verse_number": 25,
      "verse_key": "77:25",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180620,
          "resource_id": 33,
          "text": "Bukankah Kami jadikan bumi untuk (tempat) berkumpul,"
        }
      ]
    },
    {
      "id": 5648,
      "verse_number": 26,
      "verse_key": "77:26",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَحْيَآءً وَأَمْوَٰتًا",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180621,
          "resource_id": 33,
          "text": "bagi yang masih hidup dan yang sudah mati?<sup foot_note=135840>1</sup>"
        }
      ]
    },
    {
      "id": 5649,
      "verse_number": 27,
      "verse_key": "77:27",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180622,
          "resource_id": 33,
          "text": "Dan Kami jadikan padanya gunung-gunung yang tinggi, dan Kami beri minum kamu dengan air tawar?"
        }
      ]
    },
    {
      "id": 5650,
      "verse_number": 28,
      "verse_key": "77:28",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180623,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5651,
      "verse_number": 29,
      "verse_key": "77:29",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180624,
          "resource_id": 33,
          "text": "(Akan dikatakan), \"Pergilah kamu guna mendapatkan apa (azab) yang dahulu kamu dustakan."
        }
      ]
    },
    {
      "id": 5652,
      "verse_number": 30,
      "verse_key": "77:30",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180637,
          "resource_id": 33,
          "text": "Pergilah kamu mendapatkan naungan (asap api neraka) yang mempunyai tiga cabang,<sup foot_note=135841>1</sup>"
        }
      ]
    },
    {
      "id": 5653,
      "verse_number": 31,
      "verse_key": "77:31",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180628,
          "resource_id": 33,
          "text": "yang tidak melindungi dan tidak pula menolak nyala api neraka.\""
        }
      ]
    },
    {
      "id": 5654,
      "verse_number": 32,
      "verse_key": "77:32",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180629,
          "resource_id": 33,
          "text": "Sungguh, (neraka) itu menyemburkan bunga api (sebesar dan setinggi) istana,"
        }
      ]
    },
    {
      "id": 5655,
      "verse_number": 33,
      "verse_key": "77:33",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180630,
          "resource_id": 33,
          "text": "seakan-akan iring-iringan unta yang kuning."
        }
      ]
    },
    {
      "id": 5656,
      "verse_number": 34,
      "verse_key": "77:34",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180631,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5657,
      "verse_number": 35,
      "verse_key": "77:35",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180632,
          "resource_id": 33,
          "text": "Inilah hari, saat mereka tidak dapat berbicara,"
        }
      ]
    },
    {
      "id": 5658,
      "verse_number": 36,
      "verse_key": "77:36",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 179993,
          "resource_id": 33,
          "text": "dan tidak diizinkan kepada mereka mengemukakan alasan agar mereka dimaafkan."
        }
      ]
    },
    {
      "id": 5659,
      "verse_number": 37,
      "verse_key": "77:37",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180633,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5660,
      "verse_number": 38,
      "verse_key": "77:38",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180634,
          "resource_id": 33,
          "text": "Inilah hari keputusan; (pada hari ini) Kami kumpulkan kamu dan orang-orang yang terdahulu."
        }
      ]
    },
    {
      "id": 5661,
      "verse_number": 39,
      "verse_key": "77:39",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180635,
          "resource_id": 33,
          "text": "Maka jika kamu punya tipu daya, maka lakukanlah (tipu daya) itu terhadap-Ku."
        }
      ]
    },
    {
      "id": 5662,
      "verse_number": 40,
      "verse_key": "77:40",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180638,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5663,
      "verse_number": 41,
      "verse_key": "77:41",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 177482,
          "resource_id": 33,
          "text": "Sungguh, orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (di sekitar) mata air,"
        }
      ]
    },
    {
      "id": 5664,
      "verse_number": 42,
      "verse_key": "77:42",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180639,
          "resource_id": 33,
          "text": "dan buah-buahan yang mereka sukai."
        }
      ]
    },
    {
      "id": 5665,
      "verse_number": 43,
      "verse_key": "77:43",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180640,
          "resource_id": 33,
          "text": "(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\""
        }
      ]
    },
    {
      "id": 5666,
      "verse_number": 44,
      "verse_key": "77:44",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180641,
          "resource_id": 33,
          "text": "Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."
        }
      ]
    },
    {
      "id": 5667,
      "verse_number": 45,
      "verse_key": "77:45",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180642,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5668,
      "verse_number": 46,
      "verse_key": "77:46",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180643,
          "resource_id": 33,
          "text": "(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\""
        }
      ]
    },
    {
      "id": 5669,
      "verse_number": 47,
      "verse_key": "77:47",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180648,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."
        }
      ]
    },
    {
      "id": 5670,
      "verse_number": 48,
      "verse_key": "77:48",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180645,
          "resource_id": 33,
          "text": "Dan apabila dikatakan kepada mereka, \"Rukuklah,\" mereka tidak mau rukuk.<sup foot_note=135842>1</sup>"
        }
      ]
    },
    {
      "id": 5671,
      "verse_number": 49,
      "verse_key": "77:49",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 77,
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 180646,
          "resource_id": 33,
          "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)!"
        }
      ]
    },
    {
