{
  "verses": [
    {
      "id": 4727,
      "verse_number": 52,
      "verse_key": "51:52",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179307,
          "resource_id": 33,
          "text": "Demikianlah setiap kali seorang rasul yang datang kepada orang-orang yang sebelum mereka, mereka (kaumnya) pasti mengatakan, \"Dia itu pesihir atau orang gila.\""
        }
      ]
    },
    {
      "id": 4728,
      "verse_number": 53,
      "verse_key": "51:53",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌ طَاغُونَ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179308,
          "resource_id": 33,
          "text": "Apakah mereka saling berpesan tentang apa yang dikatakan itu. Sebenarnya mereka adalah kaum yang melampaui batas."
        }
      ]
    },
    {
      "id": 4729,
      "verse_number": 54,
      "verse_key": "51:54",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179309,
          "resource_id": 33,
          "text": "Maka berpalinglah engkau dari mereka, dan engkau sama sekali tidak tercela."
        }
      ]
    },
    {
      "id": 4730,
      "verse_number": 55,
      "verse_key": "51:55",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179310,
          "resource_id": 33,
          "text": "Dan tetaplah memberi peringatan, karena sesungguhnya peringatan itu bermanfaat bagi orang-orang mukmin."
        }
      ]
    },
    {
      "id": 4731,
      "verse_number": 56,
      "verse_key": "51:56",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179311,
          "resource_id": 33,
          "text": "Aku tidak menciptakan jin dan manusia melainkan agar mereka beribadah kepada-Ku."
        }
      ]
    },
    {
      "id": 4732,
      "verse_number": 57,
      "verse_key": "51:57",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍ وَمَآ أُرِيدُ أَن يُطْعِمُونِ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179312,
          "resource_id": 33,
          "text": "Aku tidak menghendaki rezeki sedikit pun dari mereka dan Aku tidak menghendaki agar mereka memberi makan kepada-Ku."
        }
      ]
    },
    {
      "id": 4733,
      "verse_number": 58,
      "verse_key": "51:58",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179313,
          "resource_id": 33,
          "text": "Sungguh Allah, Dialah Pemberi rezeki yang mempunyai kekuatan lagi sangat kokoh."
        }
      ]
    },
    {
      "id": 4734,
      "verse_number": 59,
      "verse_key": "51:59",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًا مِّثْلَ ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا يَسْتَعْجِلُونِ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179314,
          "resource_id": 33,
          "text": "Maka sungguh, untuk orang-orang yang zalim ada bagian (azab) seperti bagian teman-teman mereka (dahulu); maka janganlah mereka meminta kepada-Ku untuk menyegerakannya."
        }
      ]
    },
    {
      "id": 4735,
      "verse_number": 60,
      "verse_key": "51:60",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 459,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَيْلٌ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ",
      "chapter_id": 51,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179318,
          "resource_id": 33,
          "text": "Maka celakalah orang-orang yang kafir pada hari yang telah dijanjikan kepada mereka (hari Kiamat)."
        }
      ]
    },
    {
      "id": 4736,
      "verse_number": 1,
      "verse_key": "52:1",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلطُّورِ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 177523,
          "resource_id": 33,
          "text": "Demi gunung (Sinai),"
        }
      ]
    },
    {
      "id": 4737,
      "verse_number": 2,
      "verse_key": "52:2",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكِتَـٰبٍ مَّسْطُورٍ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179340,
          "resource_id": 33,
          "text": "dan demi Kitab yang ditulis,"
        }
      ]
    },
    {
      "id": 4738,
      "verse_number": 3,
      "verse_key": "52:3",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى رَقٍّ مَّنشُورٍ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 181861,
          "resource_id": 33,
          "text": "pada lembaran yang terbuka,"
        }
      ]
    },
    {
      "id": 4739,
      "verse_number": 4,
      "verse_key": "52:4",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْبَيْتِ ٱلْمَعْمُورِ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179371,
          "resource_id": 33,
          "text": "demi Baitulma'mur (Ka'bah),<sup foot_note=135766>1</sup>"
        }
      ]
    },
    {
      "id": 4740,
      "verse_number": 5,
      "verse_key": "52:5",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 181541,
          "resource_id": 33,
          "text": "demi atap yang ditinggikan (langit),"
        }
      ]
    },
    {
      "id": 4741,
      "verse_number": 6,
      "verse_key": "52:6",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْبَحْرِ ٱلْمَسْجُورِ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 177411,
          "resource_id": 33,
          "text": "demi lautan yang penuh gelombang,"
        }
      ]
    },
    {
      "id": 4742,
      "verse_number": 7,
      "verse_key": "52:7",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 181865,
          "resource_id": 33,
          "text": "sungguh, azab Tuhanmu pasti terjadi,"
        }
      ]
    },
    {
      "id": 4743,
      "verse_number": 8,
      "verse_key": "52:8",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَّا لَهُۥ مِن دَافِعٍ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179374,
          "resource_id": 33,
          "text": "tidak sesuatu pun yang dapat menolaknya,"
        }
      ]
    },
    {
      "id": 4744,
      "verse_number": 9,
      "verse_key": "52:9",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًا",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179378,
          "resource_id": 33,
          "text": "pada hari (ketika) langit berguncang sekeras-kerasnya,"
        }
      ]
    },
    {
      "id": 4745,
      "verse_number": 10,
      "verse_key": "52:10",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًا",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179326,
          "resource_id": 33,
          "text": "dan gunung berjalan (berpindah-pindah)."
        }
      ]
    },
    {
      "id": 4746,
      "verse_number": 11,
      "verse_key": "52:11",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179327,
          "resource_id": 33,
          "text": "Maka celakalah pada hari itu orang-orang yang mendustakan."
        }
      ]
    },
    {
      "id": 4747,
      "verse_number": 12,
      "verse_key": "52:12",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ فِى خَوْضٍ يَلْعَبُونَ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179328,
          "resource_id": 33,
          "text": "Orang-orang yang bermain-main dalam kebatilan (perbuatan dosa),"
        }
      ]
    },
    {
      "id": 4748,
      "verse_number": 13,
      "verse_key": "52:13",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179329,
          "resource_id": 33,
          "text": "pada hari (ketika) itu mereka di dorong ke neraka Jahanam dengan sekuat-kuatnya."
        }
      ]
    },
    {
      "id": 4749,
      "verse_number": 14,
      "verse_key": "52:14",
      "hizb_number": 53,
      "rub_el_hizb_number": 209,
      "ruku_number": 460,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ",
      "chapter_id": 52,
      "page_number": 523,
      "juz_number": 27,
      "translations": [
        {
          "id": 179330,
          "resource_id": 33,
          "text": "(Dikatakan kepada mereka), \"Inilah neraka yang dahulu kamu mendustakannya.\""
        }
      ]
    }
  ],
