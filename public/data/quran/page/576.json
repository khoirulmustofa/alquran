{
  "verses": [
    {
      "id": 5513,
      "verse_number": 18,
      "verse_key": "74:18",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180456,
          "resource_id": 33,
          "text": "Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),"
        }
      ]
    },
    {
      "id": 5514,
      "verse_number": 19,
      "verse_key": "74:19",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180457,
          "resource_id": 33,
          "text": "maka celakalah dia! Bagaimana dia menetapkan?"
        }
      ]
    },
    {
      "id": 5515,
      "verse_number": 20,
      "verse_key": "74:20",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180460,
          "resource_id": 33,
          "text": "sekali lagi, celakalah dia! Bagaimana dia menetapkan?"
        }
      ]
    },
    {
      "id": 5516,
      "verse_number": 21,
      "verse_key": "74:21",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ نَظَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180503,
          "resource_id": 33,
          "text": "kemudian dia (merenung) memikirkan,"
        }
      ]
    },
    {
      "id": 5517,
      "verse_number": 22,
      "verse_key": "74:22",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ عَبَسَ وَبَسَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180463,
          "resource_id": 33,
          "text": "lalu berwajah masam dan cemberut,"
        }
      ]
    },
    {
      "id": 5518,
      "verse_number": 23,
      "verse_key": "74:23",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180461,
          "resource_id": 33,
          "text": "kemudian berpaling (dari kebenaran) dan menyombongkan diri,"
        }
      ]
    },
    {
      "id": 5519,
      "verse_number": 24,
      "verse_key": "74:24",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180462,
          "resource_id": 33,
          "text": "lalu dia berkata, \"(Alquran) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu)."
        }
      ]
    },
    {
      "id": 5520,
      "verse_number": 25,
      "verse_key": "74:25",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180468,
          "resource_id": 33,
          "text": "Ini hanyalah perkataan manusia.\""
        }
      ]
    },
    {
      "id": 5521,
      "verse_number": 26,
      "verse_key": "74:26",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَأُصْلِيهِ سَقَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180464,
          "resource_id": 33,
          "text": "Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,"
        }
      ]
    },
    {
      "id": 5522,
      "verse_number": 27,
      "verse_key": "74:27",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180465,
          "resource_id": 33,
          "text": "Dan tahukah kamu apa (neraka) Saqar itu?"
        }
      ]
    },
    {
      "id": 5523,
      "verse_number": 28,
      "verse_key": "74:28",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا تُبْقِى وَلَا تَذَرُ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180466,
          "resource_id": 33,
          "text": "Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,<sup foot_note=135828>1</sup>"
        }
      ]
    },
    {
      "id": 5524,
      "verse_number": 29,
      "verse_key": "74:29",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَوَّاحَةٌ لِّلْبَشَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 177440,
          "resource_id": 33,
          "text": "yang menghanguskan kulit manusia."
        }
      ]
    },
    {
      "id": 5525,
      "verse_number": 30,
      "verse_key": "74:30",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَيْهَا تِسْعَةَ عَشَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180469,
          "resource_id": 33,
          "text": "Di atasnya ada sembilan belas (malaikat penjaga)."
        }
      ]
    },
    {
      "id": 5526,
      "verse_number": 31,
      "verse_key": "74:31",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 512,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180470,
          "resource_id": 33,
          "text": "Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia."
        }
      ]
    },
    {
      "id": 5527,
      "verse_number": 32,
      "verse_key": "74:32",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا وَٱلْقَمَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180501,
          "resource_id": 33,
          "text": "Tidak!<sup foot_note=135829>1</sup> Demi bulan,"
        }
      ]
    },
    {
      "id": 5528,
      "verse_number": 33,
      "verse_key": "74:33",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180481,
          "resource_id": 33,
          "text": "dan demi malam ketika telah berlalu,"
        }
      ]
    },
    {
      "id": 5529,
      "verse_number": 34,
      "verse_key": "74:34",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180473,
          "resource_id": 33,
          "text": "dan demi subuh apabila mulai terang,"
        }
      ]
    },
    {
      "id": 5530,
      "verse_number": 35,
      "verse_key": "74:35",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180472,
          "resource_id": 33,
          "text": "sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,"
        }
      ]
    },
    {
      "id": 5531,
      "verse_number": 36,
      "verse_key": "74:36",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَذِيرًا لِّلْبَشَرِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180475,
          "resource_id": 33,
          "text": "sebagai peringatan bagi manusia,"
        }
      ]
    },
    {
      "id": 5532,
      "verse_number": 37,
      "verse_key": "74:37",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180474,
          "resource_id": 33,
          "text": "(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur.<sup foot_note=135830>1</sup>"
        }
      ]
    },
    {
      "id": 5533,
      "verse_number": 38,
      "verse_key": "74:38",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180476,
          "resource_id": 33,
          "text": "Setiap orang bertanggung jawab atas apa yang telah dilakukannya,"
        }
      ]
    },
    {
      "id": 5534,
      "verse_number": 39,
      "verse_key": "74:39",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180477,
          "resource_id": 33,
          "text": "kecuali golongan kanan,"
        }
      ]
    },
    {
      "id": 5535,
      "verse_number": 40,
      "verse_key": "74:40",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّـٰتٍ يَتَسَآءَلُونَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180482,
          "resource_id": 33,
          "text": "berada di dalam surga, mereka saling menanyakan,"
        }
      ]
    },
    {
      "id": 5536,
      "verse_number": 41,
      "verse_key": "74:41",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَنِ ٱلْمُجْرِمِينَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180483,
          "resource_id": 33,
          "text": "tentang (keadaan) orang-orang yang berdosa,"
        }
      ]
    },
    {
      "id": 5537,
      "verse_number": 42,
      "verse_key": "74:42",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَا سَلَكَكُمْ فِى سَقَرَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180484,
          "resource_id": 33,
          "text": "\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\""
        }
      ]
    },
    {
      "id": 5538,
      "verse_number": 43,
      "verse_key": "74:43",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180485,
          "resource_id": 33,
          "text": "Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,"
        }
      ]
    },
    {
      "id": 5539,
      "verse_number": 44,
      "verse_key": "74:44",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180486,
          "resource_id": 33,
          "text": "dan kami (juga) tidak memberi makan orang miskin,"
        }
      ]
    },
    {
      "id": 5540,
      "verse_number": 45,
      "verse_key": "74:45",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 180487,
          "resource_id": 33,
          "text": "bahkan kami biasa berbincang (untuk tujuan yang batil), bersama orang-orang yang membicarakannya,"
        }
      ]
    },
    {
      "id": 5541,
      "verse_number": 46,
      "verse_key": "74:46",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ",
      "chapter_id": 74,
      "page_number": 576,
      "juz_number": 29,
      "translations": [
        {
          "id": 177473,
          "resource_id": 33,
          "text": "dan kami mendustakan hari pembalasan,"
        }
      ]
    },
    {
      "id": 5542,
      "verse_number": 47,
      "verse_key": "74:47",
      "hizb_number": 58,
      "rub_el_hizb_number": 230,
      "ruku_number": 513,
      "manzil_number": 7,
