{
  "verses": [
    {
      "id": 3915,
      "verse_number": 127,
      "verse_key": "37:127",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178105,
          "resource_id": 33,
          "text": "Tetapi mereka mendustakannya (Ilyas), maka sungguh, mereka akan diseret (ke neraka),"
        }
      ]
    },
    {
      "id": 3916,
      "verse_number": 128,
      "verse_key": "37:128",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 176006,
          "resource_id": 33,
          "text": "kecuali hamba-hamba Allah yang disucikan (dari dosa)."
        }
      ]
    },
    {
      "id": 3917,
      "verse_number": 129,
      "verse_key": "37:129",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178201,
          "resource_id": 33,
          "text": "Dan Kami abadikan untuk Ilyas (pujian) di kalangan orang-orang yang datang kemudian,"
        }
      ]
    },
    {
      "id": 3918,
      "verse_number": 130,
      "verse_key": "37:130",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178203,
          "resource_id": 33,
          "text": "\"selamat sejahtera bagi Ilyas.\""
        }
      ]
    },
    {
      "id": 3919,
      "verse_number": 131,
      "verse_key": "37:131",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178204,
          "resource_id": 33,
          "text": "Demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."
        }
      ]
    },
    {
      "id": 3920,
      "verse_number": 132,
      "verse_key": "37:132",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178205,
          "resource_id": 33,
          "text": "Sungguh, dia termasuk hamba-hamba Kami yang beriman."
        }
      ]
    },
    {
      "id": 3921,
      "verse_number": 133,
      "verse_key": "37:133",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178206,
          "resource_id": 33,
          "text": "Dan sungguh, Luṭ benar-benar termasuk salah seorang rasul."
        }
      ]
    },
    {
      "id": 3922,
      "verse_number": 134,
      "verse_key": "37:134",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178207,
          "resource_id": 33,
          "text": "(Ingatlah) ketika Kami telah menyelamatkan dia dan pengikutnya semua,"
        }
      ]
    },
    {
      "id": 3923,
      "verse_number": 135,
      "verse_key": "37:135",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178208,
          "resource_id": 33,
          "text": "kecuali seorang perempuan tua (istrinya) bersama-sama orang yang tinggal (di kota)."
        }
      ]
    },
    {
      "id": 3924,
      "verse_number": 136,
      "verse_key": "37:136",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178209,
          "resource_id": 33,
          "text": "Kemudian Kami binasakan orang-orang yang lain.<sup foot_note=135687>1</sup>"
        }
      ]
    },
    {
      "id": 3925,
      "verse_number": 137,
      "verse_key": "37:137",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178210,
          "resource_id": 33,
          "text": "Dan sesungguhnya kamu (penduduk Mekkah) benar-benar akan melalui (bekas-bekas) mereka pada waktu pagi,"
        }
      ]
    },
    {
      "id": 3926,
      "verse_number": 138,
      "verse_key": "37:138",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 391,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178223,
          "resource_id": 33,
          "text": "dan pada waktu malam. Maka mengapa kamu tidak mengerti?"
        }
      ]
    },
    {
      "id": 3927,
      "verse_number": 139,
      "verse_key": "37:139",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178212,
          "resource_id": 33,
          "text": "Dan sungguh, Yunus benar-benar termasuk salah seorang rasul,"
        }
      ]
    },
    {
      "id": 3928,
      "verse_number": 140,
      "verse_key": "37:140",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178214,
          "resource_id": 33,
          "text": "(ingatlah) ketika dia lari,<sup foot_note=135688>1</sup> ke kapal yang penuh muatan,"
        }
      ]
    },
    {
      "id": 3929,
      "verse_number": 141,
      "verse_key": "37:141",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178215,
          "resource_id": 33,
          "text": "kemudian dia ikut diundi<sup foot_note=135689>1</sup> ternyata dia termasuk orang-orang yang kalah (dalam undian)."
        }
      ]
    },
    {
      "id": 3930,
      "verse_number": 142,
      "verse_key": "37:142",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178216,
          "resource_id": 33,
          "text": "Maka dia ditelan oleh ikan besar dalam keadaan tercela.<sup foot_note=135690>1</sup>"
        }
      ]
    },
    {
      "id": 3931,
      "verse_number": 143,
      "verse_key": "37:143",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178217,
          "resource_id": 33,
          "text": "Maka sekiranya dia tidak termasuk orang yang banyak berzikir (bertasbih) kepada Allah,"
        }
      ]
    },
    {
      "id": 3932,
      "verse_number": 144,
      "verse_key": "37:144",
      "hizb_number": 45,
      "rub_el_hizb_number": 180,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178218,
          "resource_id": 33,
          "text": "niscaya dia akan tetap tinggal di perut (ikan itu) sampai Hari Berbangkit."
        }
      ]
    },
    {
      "id": 3933,
      "verse_number": 145,
      "verse_key": "37:145",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178219,
          "resource_id": 33,
          "text": "Kemudian Kami lemparkan dia ke daratan yang tandus, sedang dia dalam keadaan sakit."
        }
      ]
    },
    {
      "id": 3934,
      "verse_number": 146,
      "verse_key": "37:146",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178220,
          "resource_id": 33,
          "text": "Kemudian untuk dia Kami tumbuhkan sebatang pohon dari jenis labu."
        }
      ]
    },
    {
      "id": 3935,
      "verse_number": 147,
      "verse_key": "37:147",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178221,
          "resource_id": 33,
          "text": "Dan Kami utus dia kepada seratus ribu (orang) atau lebih,"
        }
      ]
    },
    {
      "id": 3936,
      "verse_number": 148,
      "verse_key": "37:148",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178222,
          "resource_id": 33,
          "text": "sehingga mereka beriman, karena itu Kami anugerahkan kenikmatan hidup kepada mereka hingga waktu tertentu."
        }
      ]
    },
    {
      "id": 3937,
      "verse_number": 149,
      "verse_key": "37:149",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178224,
          "resource_id": 33,
          "text": "Maka tanyakanlah (Muhammad) kepada mereka (orang-orang kafir Mekkah), \"Apakah anak-anak perempuan itu untuk Tuhanmu sedangkan untuk mereka anak laki-laki?<sup foot_note=135691>1</sup>"
        }
      ]
    },
    {
      "id": 3938,
      "verse_number": 150,
      "verse_key": "37:150",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178168,
          "resource_id": 33,
          "text": "atau apakah Kami menciptakan malaikat-malaikat berupa perempuan sedangkan mereka menyaksikan(nya)?"
        }
      ]
    },
    {
      "id": 3939,
      "verse_number": 151,
      "verse_key": "37:151",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178226,
          "resource_id": 33,
          "text": "Ingatlah, sesungguhnya di antara kebohongannya mereka benar-benar mengatakan,"
        }
      ]
    },
    {
      "id": 3940,
      "verse_number": 152,
      "verse_key": "37:152",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178227,
          "resource_id": 33,
          "text": "\"Allah mempunyai anak.\" Dan sungguh, mereka benar-benar pendusta,"
        }
      ]
    },
    {
      "id": 3941,
      "verse_number": 153,
      "verse_key": "37:153",
      "hizb_number": 46,
      "rub_el_hizb_number": 181,
      "ruku_number": 392,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ",
      "chapter_id": 37,
      "page_number": 451,
      "juz_number": 23,
      "translations": [
        {
          "id": 178228,
          "resource_id": 33,
          "text": "apakah Dia (Allah) memilih anak-anak perempuan daripada anak-anak laki-laki?"
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 27,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 27
  }
}