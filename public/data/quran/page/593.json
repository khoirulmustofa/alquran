{
  "verses": [
    {
      "id": 5994,
      "verse_number": 1,
      "verse_key": "89:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلْفَجْرِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 182910,
          "resource_id": 33,
          "text": "Demi fajar,"
        }
      ]
    },
    {
      "id": 5995,
      "verse_number": 2,
      "verse_key": "89:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَيَالٍ عَشْرٍ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181063,
          "resource_id": 33,
          "text": "demi malam yang sepuluh,<sup foot_note=135857>1</sup>"
        }
      ]
    },
    {
      "id": 5996,
      "verse_number": 3,
      "verse_key": "89:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 179852,
          "resource_id": 33,
          "text": "demi yang genap dan yang ganjil,"
        }
      ]
    },
    {
      "id": 5997,
      "verse_number": 4,
      "verse_key": "89:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 179934,
          "resource_id": 33,
          "text": "demi malam apabila berlalu."
        }
      ]
    },
    {
      "id": 5998,
      "verse_number": 5,
      "verse_key": "89:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181069,
          "resource_id": 33,
          "text": "Adakah pada yang demikian itu terdapat sumpah (yang dapat diterima) bagi orang-orang yang berakal?"
        }
      ]
    },
    {
      "id": 5999,
      "verse_number": 6,
      "verse_key": "89:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181071,
          "resource_id": 33,
          "text": "Tidakkah engkau (Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) 'Ād?"
        }
      ]
    },
    {
      "id": 6000,
      "verse_number": 7,
      "verse_key": "89:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181072,
          "resource_id": 33,
          "text": "(yaitu) penduduk Iram (ibukota kaum 'Ād) yang mempunyai bangunan-bangunan yang tinggi,"
        }
      ]
    },
    {
      "id": 6001,
      "verse_number": 8,
      "verse_key": "89:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181073,
          "resource_id": 33,
          "text": "yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,"
        }
      ]
    },
    {
      "id": 6002,
      "verse_number": 9,
      "verse_key": "89:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181074,
          "resource_id": 33,
          "text": "dan (terhadap) kaum Samud yang memotong batu-batu besar di lembah,<sup foot_note=135858>1</sup>"
        }
      ]
    },
    {
      "id": 6003,
      "verse_number": 10,
      "verse_key": "89:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181059,
          "resource_id": 33,
          "text": "dan (terhadap) Fir'aun yang mempunyai pasak-pasak (bangunan yang besar),"
        }
      ]
    },
    {
      "id": 6004,
      "verse_number": 11,
      "verse_key": "89:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181054,
          "resource_id": 33,
          "text": "yang berbuat sewenang-wenang dalam negeri,"
        }
      ]
    },
    {
      "id": 6005,
      "verse_number": 12,
      "verse_key": "89:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181055,
          "resource_id": 33,
          "text": "lalu mereka banyak berbuat kerusakan dalam negeri itu,"
        }
      ]
    },
    {
      "id": 6006,
      "verse_number": 13,
      "verse_key": "89:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181056,
          "resource_id": 33,
          "text": "karena itu Tuhanmu menimpakan cemeti azab kepada mereka,"
        }
      ]
    },
    {
      "id": 6007,
      "verse_number": 14,
      "verse_key": "89:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181057,
          "resource_id": 33,
          "text": "sungguh, Tuhanmu benar-benar mengawasi."
        }
      ]
    },
    {
      "id": 6008,
      "verse_number": 15,
      "verse_key": "89:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181058,
          "resource_id": 33,
          "text": "Adapun manusia, apabila Tuhan mengujinya lalu memuliakannya dan memberinya kesenangan, maka dia berkata, \"Tuhanku telah memuliakanku.\""
        }
      ]
    },
    {
      "id": 6009,
      "verse_number": 16,
      "verse_key": "89:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181068,
          "resource_id": 33,
          "text": "Namun apabila Tuhan mengujinya lalu membatasi rezekinya, maka dia berkata, \"Tuhanku telah menghinaku.\"<sup foot_note=135859>1</sup>"
        }
      ]
    },
    {
      "id": 6010,
      "verse_number": 17,
      "verse_key": "89:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181060,
          "resource_id": 33,
          "text": "Sekali-kali tidak! Bahkan kamu tidak memuliakan anak yatim,<sup foot_note=135860>1</sup>"
        }
      ]
    },
    {
      "id": 6011,
      "verse_number": 18,
      "verse_key": "89:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181061,
          "resource_id": 33,
          "text": "dan kamu tidak saling mengajak memberi makan orang miskin,"
        }
      ]
    },
    {
      "id": 6012,
      "verse_number": 19,
      "verse_key": "89:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181062,
          "resource_id": 33,
          "text": "sedangkan kamu memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),"
        }
      ]
    },
    {
      "id": 6013,
      "verse_number": 20,
      "verse_key": "89:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181064,
          "resource_id": 33,
          "text": "dan kamu mencintai harta dengan kecintaan yang berlebihan."
        }
      ]
    },
    {
      "id": 6014,
      "verse_number": 21,
      "verse_key": "89:21",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181065,
          "resource_id": 33,
          "text": "Sekali-kali tidak! Apabila bumi diguncangkan berturut-turut (berbenturan),"
        }
      ]
    },
    {
      "id": 6015,
      "verse_number": 22,
      "verse_key": "89:22",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181066,
          "resource_id": 33,
          "text": "dan datanglah Tuhanmu; dan malaikat berbaris-baris,"
        }
      ]
    },
    {
      "id": 6016,
      "verse_number": 23,
      "verse_key": "89:23",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "chapter_id": 89,
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 181067,
          "resource_id": 33,
          "text": "dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu."
        }
      ]
    }
  ],
  "pagination": {
    "per_page": 26,
    "current_page": 1,
    "next_page": null,
    "total_pages": 1,
    "total_records": 26
  }
}